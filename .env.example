# ==========================================
# Application Configuration & Security Environment
# ==========================================

# Server Port (Default: 3000)
PORT=3000

# Environment Mode: 'development' or 'production'
# In 'production', secure cookies (HTTPS) and strict session checking are enforced.
NODE_ENV=development

# Application Base URL (e.g. https://nptelhelper.com)
# Used to restrict CORS and Socket.IO origins in production
APP_URL=http://localhost:3000

# ==========================================
# Database Connection (REQUIRED)
# ==========================================
# MongoDB Connection String (Atlas URI or local mongodb://)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nptel?retryWrites=true&w=majority

# ==========================================
# Session & Cryptographic Secrets (REQUIRED IN PRODUCTION)
# ==========================================
# Generate a cryptographically strong 64+ char random secret:
# In Node.js terminal: require('crypto').randomBytes(32).toString('hex')
SESSION_SECRET=your_super_strong_cryptographic_session_secret_key_here

# JWT Secret (Optional - for future stateless API authentication)
JWT_SECRET=your_jwt_signing_secret_key_here

# ==========================================
# Administrative Accounts
# ==========================================
# Email address designated as System Administrator (bypasses visitor logging and receives admin privileges)
ADMIN_EMAIL=admin@example.com

# ==========================================
# Google OAuth 2.0 Credentials (Optional)
# ==========================================
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ==========================================
# ImageKit File Storage (REQUIRED FOR UPLOADS)
# ==========================================
# Obtain from ImageKit Dashboard -> Developer Options -> API Keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# ==========================================
# IP & Geolocation Services (Optional)
# ==========================================
# IPInfo API token for enriched geolocation metadata
IPINFO_TOKEN=your_ipinfo_api_token
