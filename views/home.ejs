    Access weekly NPTEL assignment answers directly from your dashboard.
  </p>

  <div style="margin-top:20px;">
    <a href="/dashboard">
      <button class="btn btn-submit">
        📊 Go to Dashboard
      </button>
    </a>
  </div>
</div>

</div>

<%- include("./partials/footer") %>