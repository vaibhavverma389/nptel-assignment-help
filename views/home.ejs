<%- include("./partials/header") %>

<div class="dashboard">

  <!-- Hero Welcome Card -->
  <div class="welcome-card">
    <h2>Welcome to NPTEL Assignment Portal</h2>
    <p>Search, View & Manage Weekly Assignment Answers Easily</p>
  </div>

  <!-- Feature Stats Row -->
  <div class="stats-row">

    <div class="stat-box highlight-week">
      <h4>📚 Subjects</h4>
      <p>Multiple Courses Available</p>
    </div>

    <div class="stat-box highlight-date">
      <h4>⏳ Weekly Updates</h4>
      <p>Updated Every Week</p>
