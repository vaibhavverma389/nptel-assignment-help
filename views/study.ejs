<%- include("./partials/header") %>

<div class="dashboard">

  <!-- ================= SUBJECT SELECT ================= -->
  <div class="card">
    <h2> Select Subject</h2>

    <form method="get" action="/study-material">
      <select name="subject" class="input" required onchange="this.form.submit()">
        <option value="">-- Select Subject --</option>
        <% subjects.forEach(s => { %>
          <option value="<%= s.name %>" <%= subject === s.name ? "selected" : "" %>>
            <%= s.name %>
          </option>
        <% }) %>
      </select>
    </form>
  </div>

  <!-- ================= ASSIGNMENT ================= -->
  <div class="card">
    <h2> Assignment</h2>
    <p class="muted-text">Click a week to open assignment PDF</p>

    <% if(!subject){ %>
      <p class="warning-text" style="color: red;">⚠ Please select subject first</p>
    <% } else { %>
      <p class="success-text">✓ Subject: <strong><%= subject %></strong></p>
    <% } %>

    <div class="grid-box">
      <% for(let i = 1; i <= 12; i++) { %>
        <% if(subject){ %>
          <a 
            href="/pdf/assi/<%= i %>?subject=<%= encodeURIComponent(subject) %>" 
            class="grid-item"
            title="Assignment Week <%= i %>"
          >
            Week <%= i %>
          </a>
        <% } else { %>
          <div class="grid-item disabled">Week <%= i %></div>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- ================= STUDY MATERIAL ================= -->
   <div class="card">
    <h2> Study Material</h2>
    <% if(!subject){ %>
      <p class="warning-text" style="color: red;">⚠ Please select subject first</p>
    <% } else { %>
      <p class="success-text">✓ Subject: <strong><%= subject %></strong></p>

      <% if (typeof materials !== 'undefined' && materials.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 15px;">
          <% materials.forEach(m => { %>
            <div style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.02); padding: 12px 20px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.08);">
              <span style="font-weight: 500; color: #fff;">
                <%= m.fileName || (m.week ? `Study Material Week ${m.week}` : 'Study Material') %>
              </span>
              <a href="/materials/download/<%= m._id %>" target="_blank" class="btn btn-secondary btn-sm" style="padding: 5px 12px; font-size: 0.85rem;">
                Open/Download
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted-text" style="margin-top: 15px;">No study materials uploaded for this subject yet.</p>
      <% } %>
    <% } %>
   </div>
   

</div>

<%- include("./partials/footer") %>