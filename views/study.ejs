<%- include("./partials/header") %>

<div class="dashboard">

  <div class="page-header-banner">
    <h2><i class="fa-solid fa-folder-open"></i> Course Study Material & Assignment PDFs</h2>
    <p class="muted-text">Select your enrolled subject to view weekly assignment questions, solutions, and official course materials.</p>
  </div>

  <!-- Subject Selector Card -->
  <div class="card">
    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label"><i class="fa-solid fa-book-bookmark"></i> Select Course / Subject</label>
      <form method="get" action="/study-material">
        <select name="subject" class="select select-lg" required onchange="this.form.submit()">
          <option value="">-- Choose Subject --</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s.name %>" <%= subject === s.name ? "selected" : "" %>>
              <%= s.name %>
            </option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <!-- Weekly Assignments Grid -->
  <div class="card">
    <div class="card-header-flex">
      <div>
        <h3><i class="fa-solid fa-calendar-week"></i> Weekly Assignment Solutions</h3>
        <p class="muted-text">Click on any week button to view or download the assignment PDF.</p>
      </div>
      <% if(subject){ %>
        <span class="badge badge-success"><i class="fa-solid fa-check"></i> <%= subject %></span>
      <% } else { %>
        <span class="badge badge-warning"><i class="fa-solid fa-triangle-exclamation"></i> Select Subject</span>
      <% } %>
    </div>

    <div class="grid-box">
      <% for(let i = 1; i <= 12; i++) { %>
        <% if(subject){ %>
          <a 
            href="/pdf/assi/<%= i %>?subject=<%= encodeURIComponent(subject) %>" 
            class="grid-item"
            title="Assignment Week <%= i %>"
          >
            <i class="fa-solid fa-file-pdf grid-item-icon"></i>
            <span>Week <%= i %></span>
          </a>
        <% } else { %>
          <div class="grid-item disabled">
            <i class="fa-solid fa-lock grid-item-icon"></i>
            <span>Week <%= i %></span>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Official Study Materials Section -->
  <div class="card">
    <h3><i class="fa-solid fa-box-archive"></i> Official Lecture Notes & Materials</h3>
    
    <% if(!subject){ %>
      <div class="empty-state-small">
        <i class="fa-solid fa-arrow-up muted-icon"></i>
        <p class="muted-text">Please select a subject above to view official course materials.</p>
      </div>
    <% } else { %>

      <% if (typeof materials !== 'undefined' && materials.length > 0) { %>
        <div class="materials-list-grid">
          <% materials.forEach(m => { %>
            <div class="material-card-row">
              <div class="material-info">
                <div class="material-icon-wrap">
                  <i class="fa-solid fa-file-pdf"></i>
                </div>
                <div>
                  <h4 class="material-title">
                    <%= m.fileName || (m.week ? `Study Material Week ${m.week}` : 'Study Material') %>
                  </h4>
                  <span class="muted-text" style="font-size: 0.8rem;">Official Course Resource</span>
                </div>
              </div>
              <a href="/materials/download/<%= m._id %>" target="_blank" class="btn btn-download btn-sm">
                <i class="fa-solid fa-arrow-down-to-line"></i> Download / View
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state-small">
          <i class="fa-solid fa-folder-open muted-icon"></i>
          <p class="muted-text">No official study materials uploaded for this subject yet.</p>
        </div>
      <% } %>
    <% } %>
  </div>

</div>

<%- include("./partials/footer") %>