<%- include("./partials/header") %>

<div class="dashboard">

  <div class="page-header-banner">
    <h2><i class="fa-solid fa-folder-open"></i> Course Study Material & Assignment PDFs</h2>
    <p class="muted-text">Access verified weekly assignment questions, solutions, and official course reference materials.</p>
  </div>

  <!-- Subject Selector Card -->
  <div class="card" style="margin-bottom: 25px; padding: 22px;">
    <div class="form-group" style="margin-bottom: 0;">
      <label class="form-label" style="font-size: 0.95rem; font-weight: 600; color: #fff; margin-bottom: 8px;">
        <i class="fa-solid fa-book-bookmark" style="color: var(--accent-cyan); margin-right: 6px;"></i> Select Enrolled Course / Subject
      </label>
      <form method="get" action="/study-material">
        <select name="subject" class="select select-lg" required onchange="this.form.submit()" style="font-size: 1rem; padding: 12px 18px; border-color: rgba(6, 182, 212, 0.3);">
          <option value="">-- Choose Course Subject --</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s.name %>" <%= subject === s.name ? "selected" : "" %>>
              <%= s.name %>
            </option>
          <% }) %>
        </select>
      </form>
    </div>
  </div>

  <!-- Weekly Assignments Grid -->
  <div class="card" style="margin-bottom: 25px;">
    <div class="card-header-flex" style="margin-bottom: 20px;">
      <div>
        <h3><i class="fa-solid fa-calendar-week" style="color: var(--accent-purple); margin-right: 6px;"></i> Weekly Assignment Solutions</h3>
        <p class="muted-text">Click on any active week to open and view the verified assignment question & answer PDF.</p>
      </div>
      <% if(subject){ %>
        <span class="badge badge-success" style="font-size: 0.85rem; padding: 6px 14px;">
          <i class="fa-solid fa-circle-check" style="margin-right: 4px;"></i> <%= subject %>
        </span>
      <% } else { %>
        <span class="badge badge-warning" style="font-size: 0.85rem; padding: 6px 14px;">
          <i class="fa-solid fa-triangle-exclamation" style="margin-right: 4px;"></i> Select Subject First
        </span>
      <% } %>
    </div>

    <div class="grid-box" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 14px;">
      <% for(let i = 1; i <= 12; i++) { %>
        <% if(subject){ %>
          <a 
            href="/pdf/assi/<%= i %>?subject=<%= encodeURIComponent(subject) %>" 
            class="grid-item"
            title="Assignment Solutions Week <%= i %>"
            style="text-decoration: none;"
          >
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(139, 92, 246, 0.15); display: flex; align-items: center; justify-content: center; margin-bottom: 8px;">
              <i class="fa-solid fa-file-pdf grid-item-icon" style="color: var(--accent-purple); font-size: 1.3rem;"></i>
            </div>
            <span style="font-weight: 700; font-size: 0.95rem; color: #fff;">Week <%= i %></span>
            <span style="font-size: 0.72rem; color: var(--accent-cyan); margin-top: 2px;">View PDF</span>
          </a>
        <% } else { %>
          <div class="grid-item disabled" style="opacity: 0.45; cursor: not-allowed;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: rgba(255, 255, 255, 0.05); display: flex; align-items: center; justify-content: center; margin-bottom: 8px;">
              <i class="fa-solid fa-lock grid-item-icon" style="color: var(--text-muted); font-size: 1.1rem;"></i>
            </div>
            <span style="font-weight: 600; font-size: 0.9rem; color: var(--text-muted);">Week <%= i %></span>
            <span style="font-size: 0.72rem; color: var(--text-muted); margin-top: 2px;">Locked</span>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Official Study Materials Section -->
  <div class="card">
    <div class="card-header-flex" style="margin-bottom: 20px;">
      <div>
        <h3><i class="fa-solid fa-box-archive" style="color: var(--accent-gold); margin-right: 6px;"></i> Official Lecture Notes & Materials</h3>
        <p class="muted-text">Verified instructor materials, summaries, and lecture notes for this course.</p>
      </div>
    </div>
    
    <% if(!subject){ %>
      <div class="empty-state-small" style="padding: 40px 20px; text-align: center;">
        <i class="fa-solid fa-arrow-up-long muted-icon" style="font-size: 2.2rem; color: var(--accent-cyan); margin-bottom: 12px; display: block;"></i>
        <p class="muted-text" style="font-size: 0.95rem;">Please select a course subject above to load its study materials.</p>
      </div>
    <% } else { %>

      <% if (typeof materials !== 'undefined' && materials.length > 0) { %>
        <div class="materials-list-grid" style="display: flex; flex-direction: column; gap: 12px;">
          <% materials.forEach(m => { %>
            <div class="material-card-row" style="display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-radius: var(--radius-md); background: rgba(255,255,255,0.03); border: 1px solid var(--border-light); transition: all 0.2s ease;">
              <div class="material-info" style="display: flex; align-items: center; gap: 14px;">
                <div class="material-icon-wrap" style="width: 42px; height: 42px; border-radius: 10px; background: rgba(245, 158, 11, 0.15); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                  <i class="fa-solid fa-file-pdf"></i>
                </div>
                <div>
                  <h4 class="material-title" style="color: #fff; font-size: 1rem; margin-bottom: 4px; font-weight: 600;">
                    <%= m.fileName || (m.week ? `Study Material Week ${m.week}` : 'Study Material') %>
                  </h4>
                  <span class="muted-text" style="font-size: 0.8rem;">
                    <i class="fa-solid fa-certificate" style="color: var(--accent-gold); margin-right: 4px;"></i> Official Course Resource
                  </span>
                </div>
              </div>
              <a href="/materials/download/<%= m._id %>" target="_blank" class="btn btn-download btn-sm" style="padding: 9px 16px; font-size: 0.85rem; text-decoration: none; white-space: nowrap;">
                <i class="fa-solid fa-arrow-down-to-line" style="margin-right: 6px;"></i> Download PDF
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state-small" style="padding: 40px 20px; text-align: center;">
          <i class="fa-solid fa-folder-open muted-icon" style="font-size: 2.2rem; margin-bottom: 10px; display: block;"></i>
          <p class="muted-text">No official study materials uploaded for "<%= subject %>" yet.</p>
        </div>
      <% } %>
    <% } %>
  </div>

</div>

<%- include("./partials/footer") %>
