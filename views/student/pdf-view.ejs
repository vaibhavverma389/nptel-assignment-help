<%- include("../partials/header") %>

<div class="dashboard">

  <!-- PDF Viewer Header Toolbar -->
  <div class="card pdf-toolbar-card">
    <div class="pdf-toolbar-left">
      <a href="/study-material?subject=<%= encodeURIComponent(subject) %>" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-arrow-left"></i> Back to Courses
      </a>
      <div class="pdf-title-group">
        <h2>
          <i class="fa-solid fa-file-pdf text-rose"></i> Week <%= week %> 
          <span class="badge badge-cyan"><%= type === "assignment" ? "Assignment Solution" : "Study Material" %></span>
        </h2>
        <% if (subject) { %>
          <span class="muted-text" style="font-size: 0.85rem;"><i class="fa-solid fa-book-bookmark"></i> <%= subject %></span>
        <% } %>
      </div>
    </div>

    <div class="pdf-toolbar-right">
      <!-- PREVIOUS -->
      <% if(Number(week) > 1) { %>
        <a 
          href="/pdf/<%= type === 'assignment' ? 'assi' : 'study' %>/<%= Number(week) - 1 %>?subject=<%= encodeURIComponent(subject) %>" 
          class="btn btn-secondary btn-sm" title="Previous Week">
          <i class="fa-solid fa-chevron-left"></i> Prev
        </a>
      <% } %>

      <!-- NEXT -->
      <% if(Number(week) < 12) { %>
        <a 
          href="/pdf/<%= type === 'assignment' ? 'assi' : 'study' %>/<%= Number(week) + 1 %>?subject=<%= encodeURIComponent(subject) %>" 
          class="btn btn-secondary btn-sm" title="Next Week">
          Next <i class="fa-solid fa-chevron-right"></i>
        </a>
      <% } %>
    </div>
  </div>

  <!-- PDF Content Container -->
  <% if(!material) { %>

    <div class="card empty-state" style="padding: 60px 20px; text-align: center;">
      <i class="fa-solid fa-file-circle-xmark" style="font-size: 3rem; color: var(--accent-rose); margin-bottom: 15px;"></i>
      <h3>No Document Available</h3>
      <p class="muted-text" style="margin-bottom: 20px;">The PDF solution for Week <%= week %> has not been uploaded yet for this subject.</p>

      <a href="/study-material?subject=<%= encodeURIComponent(subject) %>" class="btn btn-submit">
        <i class="fa-solid fa-folder-open"></i> Browse Other Weeks
      </a>
    </div>

  <% } else { %>

    <div class="card pdf-container">
      <div class="pdf-header">
        <div class="pdf-file-name">
          <i class="fa-solid fa-file-lines"></i> <%= material.fileName || `Week ${week} Document` %>
        </div>

        <div class="btn-group" style="margin-top: 0;">
          <% if (typeof type !== 'undefined' && type === "Note") { %>
            <a href="/notes/download/<%= material._id %>" target="_blank" class="btn btn-download btn-sm">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> Open in New Tab
            </a>
          <% } else { %>
            <a href="/materials/download/<%= material._id %>" target="_blank" class="btn btn-download btn-sm">
              <i class="fa-solid fa-arrow-up-right-from-square"></i> Open in New Tab
            </a>
          <% } %>
        </div>
      </div>

      <div class="pdf-viewer">
        <iframe 
          src="<%= secureUrl %>" 
          class="pdf-frame"
          title="PDF Viewer">
        </iframe>
      </div>
    </div>

  <% } %>

</div>

<script>
document.addEventListener("contextmenu", (e) => e.preventDefault());

document.addEventListener("keydown", function(e) {
  if ((e.ctrlKey || e.metaKey) && ["s", "p"].includes(e.key.toLowerCase())) {
    e.preventDefault();
  }
});
</script>

<%- include("../partials/footer") %>