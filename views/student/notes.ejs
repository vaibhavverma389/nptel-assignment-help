<%- include("../partials/header") %>

<div class="dashboard">
  <h2 class="page-title">My Notes Hub</h2>

  <!-- Filters & Action Header -->
  <div class="card" style="margin-bottom: 25px;">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 15px;">
      <!-- Filter Form -->
      <form method="get" action="/notes" style="display: flex; gap: 10px; flex-grow: 1; max-width: 500px;">
        <select name="subject" class="select" onchange="this.form.submit()" style="margin: 0; width: 100%;">
          <option value="">All Subjects</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s.name %>" <%= selectedSubject === s.name ? "selected" : "" %>><%= s.name %></option>
          <% }) %>
        </select>
      </form>

      <!-- Action Buttons -->
      <div style="display: flex; gap: 10px;">
        <% if (user) { %>
          <a href="/upload" class="btn btn-submit">Upload Notes</a>
          <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-submit">Login to Upload Notes</a>
        <% } %>
      </div>
    </div>
  </div>

  <% if (selectedSubject) { %>
    <!-- ================= OFFICIAL STUDY MATERIALS ================= -->
    <div class="card" style="margin-bottom: 25px;">
      <h3 style="margin-bottom: 15px; color: var(--gold); border-bottom: 1px solid var(--border-light); padding-bottom: 10px;">
        📚 Official Study Materials
      </h3>
      <% if (typeof adminMaterials !== 'undefined' && adminMaterials.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 15px;">
          <% adminMaterials.forEach(m => { %>
            <div class="card" style="margin: 0; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; border: 1px solid var(--border-light); background: rgba(255, 255, 255, 0.02);">
              <div>
                <span class="countdown-text" style="background: rgba(0, 113, 189, 0.15); color: var(--text-secondary); border-radius: 4px; padding: 3px 8px; font-size: 0.75rem;">
                  Official Material
                </span>
                <h4 style="margin-top: 10px; margin-bottom: 15px; font-size: 1.05rem; color: #fff; word-break: break-all;">
                  <%= m.fileName || 'Study Material PDF' %>
                </h4>
              </div>
              <a href="/materials/download/<%= m._id %>" target="_blank" class="btn btn-secondary btn-sm" style="align-self: flex-start; padding: 6px 12px; font-size: 0.85rem;">
                Open / Download
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p class="muted-text">No official study materials uploaded yet for this subject.</p>
      <% } %>
    </div>
  <% } %>

  <!-- ================= STUDENT NOTES HUB ================= -->
  <div class="card" style="margin-bottom: 20px; background: transparent; border: none; padding: 0;">
    <h3 style="color: #fff; margin-bottom: 10px;">
      <%= selectedSubject ? '👥 Shared Student Notes' : '👥 All Student Notes' %>
    </h3>
  </div>

  <% if (notes.length === 0) { %>
    <div class="card" style="text-align: center; padding: 50px 20px;">
      <p class="muted-text" style="font-size: 1.2rem; margin-bottom: 20px;">No student notes found matching your selection.</p>
      <a href="/upload" class="btn btn-submit">Create Your First Note</a>
    </div>
  <% } else { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <% notes.forEach(note => { %>
        <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column; justify-content: space-between; min-height: 240px; position: relative; padding: 25px;">
          <!-- Favorite Indicator Pin -->
          <form method="post" action="/notes/favorite/<%= note._id %>" style="position: absolute; top: 15px; right: 15px; z-index: 5;">
            <button type="submit" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: <%= note.isFavorite ? 'var(--gold)' : 'rgba(255,255,255,0.2)' %>;" title="<%= note.isFavorite ? 'Unfavorite' : 'Favorite' %>">
              ★
            </button>
          </form>
 
          <div>
            <!-- Subject & Uploader Info -->
            <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 10px;">
              <span class="countdown-text" style="background: rgba(0, 113, 189, 0.15); color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.75rem; border-radius: 4px; padding: 3px 8px;">
                <%= note.subject %>
              </span>
              <span class="muted-text" style="font-size: 0.75rem;">
                by <%= note.user || 'Student' %>
              </span>
            </div>

            <!-- Note Title -->
            <h3 style="margin-top: 10px; margin-bottom: 8px; font-size: 1.35rem; color: #fff; word-break: break-word;">
              <%= note.title %>
            </h3>

            <!-- Description Truncated -->
            <p class="muted-text" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 15px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
              <%= note.description || 'No description provided.' %>
            </p>
          </div>

          <!-- Attachment & Footer Actions -->
          <div style="border-top: 1px solid var(--border-light); padding-top: 15px; margin-top: 15px;">
            <% if (note.fileUrl) { %>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 15px;">
                <a href="/notes/download/<%= note._id %>" target="_blank" class="muted-text" style="font-size: 0.85rem; color: var(--primary-light); text-decoration: underline; word-break: break-all;" download>
                  <%= note.fileName || 'Download Attachment' %>
                </a>
              </div>
            <% } %>

            <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
              <!-- View / Details Link -->
              <a href="/notes/view/<%= note._id %>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;">
                View
              </a>

              <!-- Edit & Delete -->
              <div style="display: flex; gap: 5px;">
                <% if (user && (note.email === user.email || user.role === 'admin')) { %>
                  <a href="/notes/edit/<%= note._id %>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.85rem; border-color: rgba(255,255,255,0.15);" title="Edit">
                    Edit
                  </a>
                  <form method="post" action="/notes/delete/<%= note._id %>" onsubmit="return confirm('Are you sure you want to delete this note?');" style="display: inline;">
                    <button type="submit" class="btn btn-remove" style="padding: 6px 12px; font-size: 0.85rem;" title="Delete">
                      Delete
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>
