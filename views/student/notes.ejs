<%- include("../partials/header") %>

<div class="dashboard">
  <div class="page-header-banner">
    <h2><i class="fa-solid fa-book"></i> Student Notes & Study Hub</h2>
    <p class="muted-text">Browse shared student notes, access official study resources, and contribute your own notes.</p>
  </div>

  <!-- Filters & Action Header Card -->
  <div class="card" style="margin-bottom: 25px;">
    <div class="notes-filter-bar">
      <!-- Filter Form -->
      <form method="get" action="/notes" class="filter-form">
        <div class="input-icon-wrapper" style="width: 100%;">
          <i class="fa-solid fa-filter input-icon"></i>
          <select name="subject" class="select select-with-icon" onchange="this.form.submit()">
            <option value="">All Course Subjects</option>
            <% subjects.forEach(s => { %>
              <option value="<%= s.name %>" <%= selectedSubject === s.name ? "selected" : "" %>><%= s.name %></option>
            <% }) %>
          </select>
        </div>
      </form>

      <!-- Action Buttons -->
      <div class="filter-actions">
        <% if (user) { %>
          <a href="/upload" class="btn btn-submit"><i class="fa-solid fa-cloud-arrow-up"></i> Upload Notes</a>
          <a href="/dashboard" class="btn btn-secondary"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-submit"><i class="fa-solid fa-right-to-bracket"></i> Login to Upload</a>
        <% } %>
      </div>
    </div>
  </div>

  <% if (selectedSubject) { %>
    <!-- ================= OFFICIAL STUDY MATERIALS ================= -->
    <div class="card" style="margin-bottom: 30px;">
      <div class="section-title-bar">
        <h3><i class="fa-solid fa-award text-gold"></i> Official Course Study Materials</h3>
        <span class="badge badge-gold"><%= selectedSubject %></span>
      </div>
      
      <% if (typeof adminMaterials !== 'undefined' && adminMaterials.length > 0) { %>
        <div class="official-materials-grid">
          <% adminMaterials.forEach(m => { %>
            <div class="card material-item-card">
              <div class="material-card-body">
                <span class="badge badge-cyan" style="font-size: 0.75rem;">
                  <i class="fa-solid fa-file-pdf"></i> Official PDF
                </span>
                <h4 class="material-card-title">
                  <%= m.fileName || 'Study Material PDF' %>
                </h4>
              </div>
              <a href="/materials/download/<%= m._id %>" target="_blank" class="btn btn-download btn-sm">
                <i class="fa-solid fa-arrow-down-to-line"></i> Download / View
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="empty-state-small">
          <i class="fa-solid fa-folder-open muted-icon"></i>
          <p class="muted-text">No official study materials uploaded yet for <%= selectedSubject %>.</p>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- ================= STUDENT NOTES HUB ================= -->
  <div class="section-title-bar" style="margin-bottom: 20px;">
    <h3>
      <i class="fa-solid fa-users-rectangle"></i>
      <%= selectedSubject ? `Shared Notes for "${selectedSubject}"` : 'All Shared Student Notes' %>
    </h3>
  </div>

  <% if (notes.length === 0) { %>
    <div class="card empty-state" style="padding: 60px 20px; text-align: center;">
      <i class="fa-solid fa-file-circle-question" style="font-size: 3rem; color: var(--accent-cyan); margin-bottom: 15px;"></i>
      <h3>No Notes Found</h3>
      <p class="muted-text" style="margin-bottom: 20px;">Be the first student to share study notes for this course!</p>
      <a href="/upload" class="btn btn-submit">
        <i class="fa-solid fa-plus"></i> Upload Your Note
      </a>
    </div>
  <% } else { %>
    <div class="notes-cards-grid">
      <% notes.forEach(note => { %>
        <div class="card note-card">
          <!-- Favorite Indicator Pin -->
          <form method="post" action="/notes/favorite/<%= note._id %>" class="favorite-pin-form">
            <button type="submit" class="favorite-btn <%= note.isFavorite ? 'is-fav' : '' %>" title="<%= note.isFavorite ? 'Remove Favorite' : 'Save to Favorites' %>">
              <i class="<%= note.isFavorite ? 'fa-solid fa-star' : 'fa-regular fa-star' %>"></i>
            </button>
          </form>

          <div>
            <!-- Tags & Status Header -->
            <div class="note-card-tags">
              <span class="badge badge-purple">
                <i class="fa-solid fa-book-bookmark"></i> <%= note.subject %>
              </span>
              
              <% if (typeof note.status !== 'undefined' && note.status) { %>
                <% if (note.status === 'pending') { %>
                  <span class="badge badge-warning">
                    <i class="fa-solid fa-clock"></i> Pending Approval
                  </span>
                <% } else if (note.status === 'rejected') { %>
                  <span class="badge badge-danger">
                    <i class="fa-solid fa-circle-xmark"></i> Rejected
                  </span>
                <% } else if (note.status === 'approved' && user && (note.email === user.email || user.role === 'admin')) { %>
                  <span class="badge badge-success">
                    <i class="fa-solid fa-circle-check"></i> Approved
                  </span>
                <% } %>
              <% } %>
            </div>

            <!-- Note Title -->
            <h3 class="note-card-title">
              <%= note.title %>
            </h3>

            <!-- Note Description Truncated -->
            <p class="note-card-desc">
              <%= note.description || 'No description provided.' %>
            </p>
          </div>

          <!-- Attachment & Card Footer -->
          <div class="note-card-footer">
            <% if (note.fileUrl) { %>
              <div class="note-attachment-row">
                <i class="fa-solid fa-paperclip text-cyan"></i>
                <a href="/notes/download/<%= note._id %>" target="_blank" class="attachment-link" download>
                  <%= note.fileName || 'Attachment PDF' %>
                </a>
              </div>
            <% } %>

            <div class="note-actions-row">
              <!-- View / Details Link -->
              <a href="/notes/view/<%= note._id %>" class="btn btn-secondary btn-sm">
                <i class="fa-solid fa-eye"></i> View Details
              </a>

              <!-- Edit & Delete tools -->
              <div class="note-tools">
                <% if (user && (note.email === user.email || user.role === 'admin')) { %>
                  <a href="/notes/edit/<%= note._id %>" class="btn btn-secondary btn-sm" title="Edit Note">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>
                  <form method="post" action="/notes/delete/<%= note._id %>" onsubmit="return confirm('Are you sure you want to delete this note?');" style="display: inline;">
                    <button type="submit" class="btn btn-remove btn-sm" title="Delete Note">
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>

