<%- include("../partials/header") %>

<div class="dashboard">

  <div class="welcome-card">
    <h2>Welcome <span><%= user.name %></span></h2>
    <p>NPTEL Assignment Dashboard</p>
  </div>

  <div class="stats-row">
    <div class="stat-box highlight-week">
      <h4>📅 Current Week</h4>
      <p>Week <%= currentWeek %></p>
    </div>

    <div class="stat-box highlight-date">
      <h4>⏰ Last Date</h4>
      <p ><%= new Date(lastDate).toLocaleDateString("en-IN") %></p>
    </div>

   
  </div>
    <div class="stats-row">
      <a href="/submit-bulk" class="stat-box highlight-date dash-card">
        <h3>Submit Answers</h3>
        <p>Submit answers for all students</p>
      </a>
    </div>


  <div class="card" style="margin-top:30px;">
    <h3>Search NPTEL Assignments
    </h3>

    <form method="get" action="/dashboard" class="form-row">
      <select name="course" class="input" required>
        <option value="">Select Subject</option>
        <% subjects.forEach(s => { %>
          <option value="<%= s.name %>" <%= course === s.name ? "selected" : "" %>>
            <%= s.name %>
          </option>
        <% }) %>
      </select>

      <select name="week" class="input">
        <option value="">Current Week (Auto)</option>
        <% for(let i=1;i<=12;i++){ %>
          <option value="<%= i %>" <%= Number(week) === i ? "selected" : "" %>>
            Week <%= i %>
          </option>
        <% } %>
      </select>

      <button class="btn btn-submit">Search</button>
    </form>
  </div>

  <% if (course) { %>

    <div class="card">
  <h3>🧑‍🎓 Answers (Week <%= week || currentWeek %>)</h3>

  <% if (!answers || answers.length === 0) { %>
    <p class="muted-text">No answers yet</p>
  <% } else { %>

    <div class="table-wrapper">
      <table class="answer-table">
        <thead>
          <tr>
            <th>Question No.</th>
            <th>Selected Option</th>
            <th>Answered By</th>
          </tr>
        </thead>
        <tbody>
          <% answers.forEach((a, index) => { %>
            <tr>
              <td><%= a.question %></td>
              <td><b><%= a.option %></b></td>
              <td class="muted-text"><%= a.user %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } %>
</div>


    <div class="card">
      <h3>📘 Study Material</h3>

      <% if (material && material.studyMaterialUrl) { %>
        <a href="<%= material.studyMaterialUrl %>" class="btn btn-download">
          📥 Download Notes
        </a>
      <% } else { %>
        <p class="muted-text">❌ Not uploaded</p>
      <% } %>
    </div>

    <!-- FINAL ANSWER -->
    <div class="card">
      <h3>✅ Final Answer</h3>

      <% if (isWeekOver) { %>
        <% if (material && material.finalAnswerPdfUrl) { %>
          <a href="<%= material.finalAnswerPdfUrl %>" class="btn btn-download">
            📥 Download Final PDF
          </a>
        <% } else { %>
          <p class="muted-text">❌ Not uploaded</p>
        <% } %>
      <% } else { %>
        <p class="muted-text">⏳ Available after deadline</p>
      <% } %>
    </div>

  <% } %>
  <!-- <div class="card">
  <h3>📣 Official WhatsApp Group</h3>
  <p>Important updates, deadlines & final answers yahin milenge.</p>

  <a href="https://chat.whatsapp.com/YOUR_GROUP_LINK"
     target="_blank">
    <button class="whatsapp-join-btn btn btn-submit" >💬 Join WhatsApp Group</button>
  </a>
</div> -->


</div>



<%- include("../partials/footer") %>
