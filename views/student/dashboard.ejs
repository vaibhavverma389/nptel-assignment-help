<%- include("../partials/header") %>

<div class="dashboard">

  <!-- Welcome -->
  <div class="welcome-card">
    <h2>Welcome <span><%= user ? user.name : "" %></span></h2>
    <p>NPTEL Exam Dashboard</p>
  </div>

  <!-- Stats -->
  <div class="stats-row">

    <div class="stat-box highlight-week">
      <h4>🎯 Exam Date</h4>
      <p>19 April 2026</p>
    </div>

    <div class="stat-box highlight-date">
      <h4>⏳ Exam Countdown</h4>
      <p id="countdown"></p>
    </div>

  </div>

  <!-- Admit Card -->
  <a href="/admit-card" target="_blank" style="text-decoration: none;">
    <div class="card" style="margin-top:20px; text-align:center; cursor:pointer;">
      <h3> NPTEL Admit Card</h3>
      <p class="muted-text">Download your admit card before exam.</p>

      <span class="btn btn-submit">
        Download Admit Card
      </span>
    </div>
  </a>


  <!-- Study Material -->
  <a href="/study-material" target="_blank" style="text-decoration: none;">
    <div class="card" style="margin-top:20px; text-align:center; cursor:pointer;">
      <h3>📚 Study Material</h3>
      <p class="muted-text">Revise PDFs directly (No Download)</p>

      <span class="btn btn-submit">
        Open Study Material
      </span>
    </div>
  </a>

  <!-- Exam Instructions -->
  <div class="card exam-card">
  <h3>📢 Exam Instructions</h3>
  <p class="muted-text">
  Please follow all instructions carefully to avoid any issues during the exam.
</p>

  <ul class="instruction-list">
    <li>Admit card print karke le jana compulsory hai</li>
    <li>Valid ID proof (Aadhar / College ID)</li>
    <li>Exam center par 30 min pehle pahuchna</li>
    <li>Mobile allowed nahi hoga</li>
  </ul>
</div>

  <!-- Contact -->
  <div class="card" style="margin-top:30px;">
    <h3>Contact Us</h3>
    <p class="muted-text">Any issue, doubt or feedback? Send us a message.</p>

    <form action="/contact-us" method="post" class="form-column">

      <input type="text" class="input" name="name"
        placeholder="Enter Your Name" required />

      <input type="email" class="input" name="email"
        placeholder="Enter Your Email" required />

      <input type="tel" class="input" name="mobile"
        placeholder="Enter 10 Digit Mobile Number"
        pattern="[0-9]{10}" required />

      <textarea class="input" name="message" rows="4"
        placeholder="Write your message here..." required></textarea>

      <button type="submit" class="btn btn-submit">
        Send Message
      </button>

    </form>
  </div>

</div>

<!-- Countdown Script -->
<script>
const examDate = new Date("2026-04-19T09:00:00").getTime();

const timer = setInterval(() => {
  const now = new Date().getTime();
  const diff = examDate - now;

  if (diff <= 0) {
    document.getElementById("countdown").innerHTML = "Exam Started 🚀";
    clearInterval(timer);
    return;
  }

  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));

  document.getElementById("countdown").innerHTML =
    days + "d " + hours + "h left";
}, 1000);
</script>

<%- include("../partials/footer") %>