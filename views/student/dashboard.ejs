<%- include("../partials/header") %>

<div class="dashboard">

  <!-- Welcome -->
  <div class="welcome-card">
    <h2>Welcome <span><%= user ? user.name : "Student" %></span></h2>
    <p>📚 Student Notes Hub</p>
  </div>

  <!-- Overview Stats -->
  <div class="stats-row">

    <div class="stat-box">
      <label>👤 User</label>
      <p style="font-size: 1.15rem; word-break: break-all;"><%= user ? user.email : "Guest" %></p>
    </div>

    <div class="stat-box">
      <label>📄 Personal Notes</label>
      <p><%= typeof personalNotesCount !== 'undefined' ? personalNotesCount : 0 %></p>
    </div>

    <div class="stat-box">
      <label>⭐ Favorites</label>
      <p><%= typeof favoriteNotesCount !== 'undefined' ? favoriteNotesCount : 0 %></p>
    </div>

    <div class="stat-box highlight-week">
      <label>🔥 Active Streak</label>
      <p><%= typeof streak !== 'undefined' ? streak : 0 %> Days</p>
    </div>

  </div>

  <!-- Action Cards -->
  <div class="grid">

    <a href="/notes">
      <div class="card action-card">
        <h3>📄 My Notes</h3>
        <p>View and manage your study notes</p>
      </div>
    </a>

    <a href="/upload">
      <div class="card action-card">
        <h3>⬆️ Upload Notes</h3>
        <p>Add new notes to your collection</p>
      </div>
    </a>

    <a href="/favorites">
      <div class="card action-card">
        <h3>⭐ Favorite Notes</h3>
        <p>Quick access to saved notes</p>
      </div>
    </a>

    <a href="/recent">
      <div class="card action-card">
        <h3>🕒 Recent Activity</h3>
        <p>Continue where you left off</p>
      </div>
    </a>

  </div>

  <!-- Search Section -->
  <div class="card" style="margin-top:30px;">
    <h3>🔍 Search Notes</h3>

    <form action="/search" method="GET" class="form-row">
      <input type="text" name="query" class="input"
        placeholder="Search by subject, topic..." required />
      <button type="submit" class="btn btn-submit">Search</button>
    </form>
  </div>

  <!-- Insights -->
  <div class="card" style="margin-top:30px;">
    <h3>📈 Study Insights</h3>
    <p class="muted-text">
      Track your study patterns and improve productivity.
    </p>

    <ul class="instruction-list">
      <li>✔ <strong>Notes Usage:</strong> <%= typeof personalNotesCount !== 'undefined' ? personalNotesCount : 0 %> notes uploaded</li>
      <li>✔ <strong>Most Viewed Subject:</strong> <%= typeof mostViewedSubject !== 'undefined' ? mostViewedSubject : "None yet" %></li>
      <li>✔ <strong>Streak Tracking:</strong> <%= typeof streak !== 'undefined' ? streak : 0 %> days active</li>
      <li>✔ <strong>Recent Activity:</strong> <%= typeof recentActivityCount !== 'undefined' ? recentActivityCount : 0 %> notes accessed this week</li>
    </ul>
  </div>

  <!-- Features (Resume Boost) -->
  <div class="card" style="margin-top:30px;">
    <h3>⚙️ Platform Features</h3>

    <ul class="instruction-list">
      <li>✔ Secure Login & Authentication</li>
      <li>✔ Dynamic Dashboard Rendering (EJS)</li>
      <li>✔ REST API Ready Backend</li>
      <li>✔ Modular & Scalable Design</li>
      <li>✔ Responsive UI for all devices</li>
    </ul>
  </div>

  <!-- Contact -->
  <div class="card" style="margin-top:30px;">
    <h3>📞 Support</h3>
    <p class="muted-text">Need help? Contact us anytime.</p>

    <form action="/contact-us" method="post" class="form-column">

      <input type="text" class="input" name="name"
        placeholder="Enter Your Name" required />

      <input type="email" class="input" name="email"
        placeholder="Enter Your Email" required />

      <input type="tel" class="input" name="mobile"
        placeholder="Enter 10 Digit Mobile Number"
        pattern="[0-9]{10}" required />

      <textarea class="input" name="message" rows="4"
        placeholder="Write your message here..." required></textarea>

      <button type="submit" class="btn btn-submit">
        Send Message
      </button>

    </form>
  </div>

</div>

<%- include("../partials/footer") %>