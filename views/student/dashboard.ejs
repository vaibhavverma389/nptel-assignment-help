<%- include("../partials/header") %>

<div class="dashboard">

  <!-- Welcome Banner -->
  <div class="welcome-card">
    <div class="welcome-badge">
      <i class="fa-solid fa-fire"></i> Active Streak: <strong><%= typeof streak !== 'undefined' ? streak : 0 %> Days</strong>
    </div>
    <h2>Welcome Back, <span><%= user ? user.name : "Student" %></span> 👋</h2>
    <p>Your academic hub for notes, weekly assignment solutions, and study materials.</p>
  </div>

  <!-- Overview Stats Row -->
  <div class="stats-row">

    <div class="stat-box highlight-cyan">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-user-graduate"></i>
      </div>
      <div>
        <label>Account</label>
        <p style="font-size: 1.1rem; word-break: break-all;"><%= user ? user.name : "Guest" %></p>
      </div>
    </div>

    <div class="stat-box highlight-week">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-note-sticky"></i>
      </div>
      <div>
        <label>Personal Notes</label>
        <p><%= typeof personalNotesCount !== 'undefined' ? personalNotesCount : 0 %></p>
      </div>
    </div>

    <div class="stat-box highlight-gold">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-star"></i>
      </div>
      <div>
        <label>Saved Favorites</label>
        <p><%= typeof favoriteNotesCount !== 'undefined' ? favoriteNotesCount : 0 %></p>
      </div>
    </div>

    <div class="stat-box highlight-streak">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-bolt"></i>
      </div>
      <div>
        <label>Study Streak</label>
        <p><%= typeof streak !== 'undefined' ? streak : 0 %> Days</p>
      </div>
    </div>

  </div>

  <!-- Quick Action Cards Grid -->
  <div class="dashboard-actions">

    <a href="/notes" class="dash-card">
      <div class="dash-card-icon"><i class="fa-solid fa-book-open"></i></div>
      <h3>My Shared Notes</h3>
      <p>View, manage, and download all uploaded study notes.</p>
      <div class="card-actions">Explore Notes <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <a href="/upload" class="dash-card">
      <div class="dash-card-icon upload-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
      <h3>Upload Notes</h3>
      <p>Share new lecture notes and study material with your peers.</p>
      <div class="card-actions">Upload Now <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <a href="/study-material" class="dash-card">
      <div class="dash-card-icon study-icon"><i class="fa-solid fa-folder-open"></i></div>
      <h3>Weekly Assignments</h3>
      <p>Access weekly NPTEL assignment answers and solution PDFs.</p>
      <div class="card-actions">Browse Materials <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <a href="/favorites" class="dash-card">
      <div class="dash-card-icon fav-icon"><i class="fa-solid fa-heart"></i></div>
      <h3>Favorite Notes</h3>
      <p>Quick access to saved notes and essential guides.</p>
      <div class="card-actions">View Favorites <i class="fa-solid fa-arrow-right"></i></div>
    </a>

  </div>

  <!-- Browse by Subject Section -->
  <div class="card">
    <div class="card-header-flex">
      <div>
        <h3><i class="fa-solid fa-layer-group"></i> Browse Notes by Subject</h3>
        <p class="muted-text">Click on any course or subject to view shared student notes and official study materials.</p>
      </div>
    </div>

    <div class="subject-grid">
      <% subjects.forEach(s => { %>
        <a href="/notes?subject=<%= encodeURIComponent(s.name) %>" class="subject-pill-card">
          <div class="subject-icon"><i class="fa-solid fa-book-bookmark"></i></div>
          <h4><%= s.name %></h4>
          <span class="subject-arrow"><i class="fa-solid fa-chevron-right"></i></span>
        </a>
      <% }) %>
    </div>
  </div>

  <!-- Search Notes Card -->
  <div class="card">
    <h3><i class="fa-solid fa-magnifying-glass"></i> Search Notes & Topics</h3>
    <p class="muted-text">Find notes instantly by subject, topic name, or keywords.</p>

    <form action="/search" method="GET" class="search-form-row">
      <div class="input-icon-wrapper" style="flex-grow: 1;">
        <i class="fa-solid fa-magnifying-glass input-icon"></i>
        <input type="text" name="query" class="input input-with-icon" placeholder="Search by subject, topic, or keyword..." required />
      </div>
      <button type="submit" class="btn btn-submit">
        <i class="fa-solid fa-search"></i> Search
      </button>
    </form>
  </div>

  <!-- Insights & Platform Features Row -->
  <div class="form-row" style="margin-top: 25px;">
    
    <div class="card" style="margin-bottom: 0;">
      <h3><i class="fa-solid fa-chart-line"></i> Study Insights</h3>
      <p class="muted-text">Track your learning progress & platform activity.</p>

      <ul class="instruction-list">
        <li><i class="fa-solid fa-check-circle text-success"></i> <strong>Uploaded Notes:</strong> <%= typeof personalNotesCount !== 'undefined' ? personalNotesCount : 0 %> files</li>
        <li><i class="fa-solid fa-check-circle text-success"></i> <strong>Top Subject:</strong> <%= typeof mostViewedSubject !== 'undefined' ? mostViewedSubject : "None yet" %></li>
        <li><i class="fa-solid fa-check-circle text-success"></i> <strong>Active Streak:</strong> <%= typeof streak !== 'undefined' ? streak : 0 %> days streak</li>
        <li><i class="fa-solid fa-check-circle text-success"></i> <strong>Weekly Activity:</strong> <%= typeof recentActivityCount !== 'undefined' ? recentActivityCount : 0 %> notes accessed</li>
      </ul>
    </div>

    <div class="card" style="margin-bottom: 0;">
      <h3><i class="fa-solid fa-shield-halved"></i> Platform Features</h3>
      <p class="muted-text">Built for performance and seamless access.</p>

      <ul class="instruction-list">
        <li><i class="fa-solid fa-lock text-cyan"></i> Secure Google & Password Authentication</li>
        <li><i class="fa-solid fa-file-pdf text-cyan"></i> Embedded High-Speed PDF Viewer</li>
        <li><i class="fa-solid fa-mobile-screen text-cyan"></i> Fully Responsive Glassmorphic Interface</li>
        <li><i class="fa-solid fa-bolt text-cyan"></i> Real-time Active User Tracking</li>
      </ul>
    </div>

  </div>

  <!-- Contact & Support Section -->
  <div class="card" id="contact-support" style="margin-top:30px;">
    <h3><i class="fa-solid fa-headset"></i> Support & Contact</h3>
    <p class="muted-text">Need help or want to request assignment solutions for a new course? Contact us anytime.</p>

    <form action="/contact-us" method="post" class="form-column" style="margin-top: 15px;">

      <div class="form-row" style="margin-bottom: 0;">
        <div class="form-group">
          <label class="form-label">Your Name</label>
          <div class="input-icon-wrapper">
            <i class="fa-solid fa-user input-icon"></i>
            <input type="text" class="input input-with-icon" name="name" placeholder="Enter Your Name" required />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Email Address</label>
          <div class="input-icon-wrapper">
            <i class="fa-solid fa-at input-icon"></i>
            <input type="email" class="input input-with-icon" name="email" placeholder="Enter Your Email" required />
          </div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Mobile Number</label>
        <div class="input-icon-wrapper">
          <i class="fa-solid fa-phone input-icon"></i>
          <input type="tel" class="input input-with-icon" name="mobile" placeholder="10 Digit Mobile Number" pattern="[0-9]{10}" required />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Message</label>
        <textarea class="input" name="message" rows="4" placeholder="Describe your question or feedback here..." required></textarea>
      </div>

      <button type="submit" class="btn btn-submit" style="align-self: flex-start;">
        <i class="fa-solid fa-paper-plane"></i> Send Message
      </button>

    </form>
  </div>

</div>

<%- include("../partials/footer") %>