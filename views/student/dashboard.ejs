    <%- include("../partials/header") %>

    <div class="dashboard">

      <div class="welcome-card">
        <h2>Welcome <span><%= user.name %></span></h2>
        <p>NPTEL Assignment Dashboard</p>
      </div>

      <div class="stats-row">
        <div class="stat-box highlight-week">
          <h4>📅 Current Week</h4>
          <p>Week 3</p>
        </div>

        <div class="stat-box highlight-date">
          <h4>⏰ Last Date</h4>
          <p > 11/02/2026</p>
        </div>

      
      </div>
        <!-- <div class="stats-row">
          <a href="/submit-bulk" class="stat-box highlight-date dash-card">
            <h3>Submit Answers</h3>
            <p>Submit answers for all students</p>
          </a>
        </div> -->


      <div class="card" style="margin-top:30px;">
        <h3>Search NPTEL Assignments
        </h3>

        <form method="get" action="/dashboard" class="form-row">
          <select name="course" class="input" required>
            <option value="">Select Subject</option>
            <% subjects.forEach(s => { %>
              <option value="<%= s.name %>" <%= course === s.name ? "selected" : "" %>>
                <%= s.name %>
              </option>
            <% }) %>
          </select>

          <select name="week" class="input">
            <% for(let i=1;i<=12;i++){ %>
              <option value="<%= i %>" <%= Number(week) === i ? "selected" : "" %>>
                Week <%= i %>
              </option>
            <% } %>
          </select>

          <button class="btn btn-submit">Search</button>
        </form>
      </div>

      <% if (course) { %>

        <div class="card">
      <h3>🧑‍🎓 Answers (Week <%= week || currentWeek %>)</h3>

      <% if (!answers || answers.length === 0) { %>
        <p class="muted-text">No answers yet</p>
      <% } else { %>

        <div class="table-wrapper">
          <table class="answer-table">
            <thead>
              <tr>
                <th>Question No.</th>
                <th>Selected Option</th>
                <!-- <th>Submit By</th> -->
              </tr>
            </thead>
            <tbody>
              <% answers.forEach((a, index) => { %>
                <tr>
                  <td><%= a.question %></td>
                  <td><b><%= a.option %></b></td>
                  <!-- <td><b>Vaibhav Verma</b></td> -->
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

      <% } %>
    </div>


      <% } %>


<div class="card" style="margin-top:30px;">
  <h3>📞 Contact Us</h3>
  <p class="muted-text">Any issue, doubt or feedback? Send us a message.</p>

  <form action="/contact-us" method="post" class="form-column">

    <!-- Name (from login) -->
    <input
      type="text"
      class="input"
      name="name"
      value="<%= user.name %>"
      readonly
    />

    <!-- Email (from login) -->
    <input
      type="email"
      class="input"
      name="email"
      value="<%= user.email %>"
      readonly
    />

    <!-- Mobile -->
    <input
      type="tel"
      class="input"
      name="mobile"
      placeholder="Enter 10 Digit Mobile Number"
      pattern="[0-9]{10}"
      required
    />

    <!-- Message -->
    <textarea
      class="input"
      name="message"
      rows="4"
      placeholder="Write your message here..."
      required
    ></textarea>

    <button type="submit" class="btn btn-submit">
      📩 Send Message
    </button>
  </form>
</div>

    </div>



    <%- include("../partials/footer") %>
