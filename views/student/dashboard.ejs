    <%- include("../partials/header") %>

    <div class="dashboard">

      <div class="welcome-card">
        <h2>Welcome <span><%= user ? user.name : "" %></span></h2>
        <p>NPTEL Assignment Dashboard</p>
      </div>

      <div class="stats-row">
        <div class="stat-box highlight-week">
          <h4>📅 Current Week</h4>
          <p>Week 11</p>
        </div>

        <div class="stat-box highlight-date">
          <h4>⏰ Last Date</h4>
          <p > 08/04/2026</p>
        </div>

      
      </div>
      <a href="/admit-card" target="_blank" style="text-decoration: none;">
  <div class="card" style="margin-top:20px; text-align:center; cursor:pointer;">
    <h3>🎫 NPTEL Admit Card</h3>
    <p class="muted-text">Download your admit card before exam.</p>

    <span class="btn btn-submit">
      Download Admit Card
    </span>
  </div>
</a> 


      <div class="card" style="margin-top:30px;">
        <h3>Search NPTEL Assignments
        </h3>

        <form method="get" action="/dashboard" class="form-row">
          <select name="course" class="input" required>
            <option value="">Select Subject</option>
            <% subjects.forEach(s => { %>
              <option value="<%= s.name %>" <%= course === s.name ? "selected" : "" %>>
                <%= s.name %>
              </option>
            <% }) %>
          </select>

          <select name="week" class="input">
            <% for(let i=1;i<=12;i++){ %>
              <option value="<%= i %>" <%= Number(week) === i ? "selected" : "" %>>
                Week <%= i %>
              </option>
            <% } %>
          </select>

          <button class="btn btn-submit">Search</button>
        </form>
      </div>

      <% if (course) { %>

        <div class="card">
      <h3>🧑‍🎓 Answers (Week <%= week || currentWeek %>)</h3>

      <% if (!answers || answers.length === 0) { %>
        <p class="muted-text" id="check-info">No answers available for this week yet.</p>

      <% } else { %>

        <div class="table-wrapper">
          <table class="answer-table">
            <thead>
              <tr>
                <th style="width: 150px"></th>
                <th>Question No.</th>
                <th>Selected Option</th>
                <!-- <th>Submit By</th> -->
              </tr>
            </thead>
            <tbody>
              <% answers.forEach((a, index) => { %>
                <tr>
                  <td style="width: 150px">Week <%= week || a.week || currentWeek %></td>
                  <td><%= a.question %></td>
                  <td><b><%= a.option %></b></td>
                  <!-- <td>
  <b>
    <%= a.email && a.email.toLowerCase() === "vaibhavverma6393@gmail.com"
        ? "Vaibhav Verma"
        : "Kshtiz Tiwari"
    %>
  </b>
</td> -->

                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

      <% } %>
    </div>


      <% } %>

    <!-- <div class="bus-groups"> -->

  <!-- Non AC Bus -->
   <a href="/join-bus-nonac" class="bus-card-link">
    <div class="card bus-card">
      <h3>🚌 Budget Bus (Non-AC)</h3>

      <p class="muted-text">
        NPTEL exam center jaane ke liye affordable bus service.
        Updates ke liye WhatsApp group join karein.
      </p>

      <div class="join-area">
        <span class="btn-join">Join Non-AC Group</span>
      </div>
    </div>
  </a> 

  <!-- AC Bus -->
   <a href="/join-bus-ac" class="bus-card-link">
    <div class="card bus-card">
      <h3>❄ Premium Bus (AC)</h3>

      <p class="muted-text">
        Comfortable AC bus se exam center travel karein.
        Updates ke liye WhatsApp group join karein.
      </p>

      <div class="join-area">
        <span class="btn-join">Join AC Group</span>
      </div>
    </div>
  </a> 

<!-- </div> -->
<div class="card" style="margin-top:30px;">
  <h3>Contact Us</h3>
  <p class="muted-text">Any issue, doubt or feedback? Send us a message.</p>

  <form action="/contact-us" method="post" class="form-column">

    <!-- Name (from login) -->
    <input
      type="text"
      class="input"
      name="name"
      placeholder=" Enter Your Name"
    />

    <!-- Email (from login) -->
    <input
  type="hidden"
  name="email"
  value=" <%= user ? user.email : " " %>"
/>


    <!-- Mobile -->
    <input
      type="tel"
      class="input"
      name="mobile"
      placeholder="Enter 10 Digit Mobile Number"
      pattern="[0-9]{10}"
      required
    />

    <!-- Message -->
    <textarea
      class="input"
      name="message"
      rows="4"
      placeholder="Write your message here..."
      required
    ></textarea>

    <button type="submit" class="btn btn-submit">
      Send Message
    </button>
  </form>
</div>

    </div>

   
<script>

const params = new URLSearchParams(window.location.search);

const course = params.get("course");
const week = params.get("week");

if(course && week){

  // URL clean
  window.history.replaceState({}, "", "/dashboard");

}

</script>


