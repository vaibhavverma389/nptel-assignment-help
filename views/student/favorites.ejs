<%- include("../partials/header") %>

<div class="dashboard">
  <div class="page-header-banner">
    <h2><i class="fa-solid fa-star text-gold"></i> Saved Favorite Notes</h2>
    <p class="muted-text">Quick access to all your bookmarked lecture notes and study guides.</p>
  </div>

  <div style="text-align: right; margin-bottom: 25px;">
    <a href="/notes" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Notes Hub</a>
  </div>

  <% if (notes.length === 0) { %>
    <div class="card empty-state" style="padding: 60px 20px; text-align: center;">
      <i class="fa-solid fa-star" style="font-size: 3rem; color: var(--accent-gold); margin-bottom: 15px;"></i>
      <h3>No Favorites Saved Yet</h3>
      <p class="muted-text" style="margin-bottom: 20px;">Click the star icon on any note card in the Notes Hub to save it here for quick access.</p>
      <a href="/notes" class="btn btn-submit">
        <i class="fa-solid fa-magnifying-glass"></i> Explore Notes Hub
      </a>
    </div>
  <% } else { %>
    <div class="notes-cards-grid">
      <% notes.forEach(note => { %>
        <div class="card note-card">
          <!-- Favorite Toggle Icon Form -->
          <form method="post" action="/notes/favorite/<%= note._id %>" class="favorite-pin-form">
            <button type="submit" class="favorite-btn is-fav" title="Remove from Favorites">
              <i class="fa-solid fa-star"></i>
            </button>
          </form>

          <div>
            <!-- Subject Tag -->
            <span class="badge badge-purple" style="margin-bottom: 12px;">
              <i class="fa-solid fa-book-bookmark"></i> <%= note.subject %>
            </span>

            <!-- Note Title -->
            <h3 class="note-card-title">
              <%= note.title %>
            </h3>

            <!-- Description Truncated -->
            <p class="note-card-desc">
              <%= note.description || 'No description provided.' %>
            </p>
          </div>

          <!-- Attachment & Footer Actions -->
          <div class="note-card-footer">
            <% if (note.fileUrl) { %>
              <div class="note-attachment-row">
                <i class="fa-solid fa-paperclip text-cyan"></i>
                <a href="/notes/download/<%= note._id %>" target="_blank" class="attachment-link" download>
                  <%= note.fileName || 'Attachment PDF' %>
                </a>
              </div>
            <% } %>

            <div class="note-actions-row">
              <a href="/notes/view/<%= note._id %>" class="btn btn-secondary btn-sm" style="width: 100%;">
                <i class="fa-solid fa-eye"></i> View Details
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>

