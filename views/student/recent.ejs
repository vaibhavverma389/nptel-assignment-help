<%- include("../partials/header") %>

<div class="dashboard">
  <div class="page-header-banner">
    <h2><i class="fa-solid fa-clock-rotate-left"></i> Recent Activity</h2>
    <p class="muted-text">Resume your study sessions right where you left off.</p>
  </div>

  <div style="text-align: right; margin-bottom: 25px;">
    <a href="/notes" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Notes Hub</a>
  </div>

  <% if (notes.length === 0) { %>
    <div class="card empty-state" style="padding: 60px 20px; text-align: center;">
      <i class="fa-solid fa-clock-rotate-left" style="font-size: 3rem; color: var(--accent-cyan); margin-bottom: 15px;"></i>
      <h3>No Recent Activity</h3>
      <p class="muted-text" style="margin-bottom: 20px;">Notes you view or open will be saved here for easy access.</p>
      <a href="/notes" class="btn btn-submit">
        <i class="fa-solid fa-book"></i> Browse Notes
      </a>
    </div>
  <% } else { %>
    <div class="notes-cards-grid">
      <% notes.forEach(note => { %>
        <div class="card note-card">
          <div>
            <!-- Subject Tag -->
            <span class="badge badge-purple" style="margin-bottom: 12px;">
              <i class="fa-solid fa-book-bookmark"></i> <%= note.subject %>
            </span>

            <!-- Note Title -->
            <h3 class="note-card-title">
              <%= note.title %>
            </h3>

            <!-- Access Timestamp -->
            <div class="recent-time-badge">
              <i class="fa-regular fa-clock"></i> Accessed: <%= new Date(note.lastAccessed).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }) %>
            </div>
          </div>

          <!-- Footer Actions -->
          <div class="note-card-footer">
            <a href="/notes/view/<%= note._id %>" class="btn btn-submit btn-sm" style="width: 100%;">
              <i class="fa-solid fa-play"></i> Resume Study
            </a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>

