<%- include("../partials/header") %>

<div class="dashboard">

  <div class="page-header-banner">
    <h2><i class="fa-solid fa-pen-to-square"></i> Edit Note Details</h2>
    <p class="muted-text">Update the title, course category, or description of your note.</p>
  </div>

  <form method="post" action="/notes/edit/<%= note._id %>" class="card centered-card" style="max-width: 680px; margin: 0 auto 30px;">
    <div class="form-column">
      
      <!-- Title -->
      <div class="form-group">
        <label class="form-label" for="title"><i class="fa-solid fa-heading"></i> Note Title</label>
        <div class="input-icon-wrapper">
          <i class="fa-solid fa-pen input-icon"></i>
          <input type="text" id="title" name="title" class="input input-with-icon" value="<%= note.title %>" required />
        </div>
      </div>

      <!-- Subject Selection -->
      <div class="form-group">
        <label class="form-label" for="subject"><i class="fa-solid fa-book-bookmark"></i> Select Course / Subject</label>
        <div class="input-icon-wrapper">
          <i class="fa-solid fa-list-check input-icon"></i>
          <select id="subject" name="subject" class="select select-with-icon" required>
            <% subjects.forEach(s => { %>
              <option value="<%= s.name %>" <%= note.subject === s.name ? "selected" : "" %>><%= s.name %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <!-- Content / Description -->
      <div class="form-group">
        <label class="form-label" for="description"><i class="fa-solid fa-align-left"></i> Note Description</label>
        <textarea id="description" name="description" rows="7" class="input" placeholder="Type key insights, study points, or details..."><%= note.description %></textarea>
      </div>

      <!-- Attached File Notice -->
      <% if (note.fileUrl) { %>
        <div class="attachment-notice-box">
          <span class="attachment-label"><i class="fa-solid fa-paperclip text-cyan"></i> Attached Document:</span>
          <a href="<%= note.fileUrl %>" target="_blank" class="attachment-filename">
            <%= note.fileName || 'View Attachment' %>
          </a>
          <p class="muted-text" style="font-size: 0.8rem; margin-top: 5px; margin-bottom: 0;">
            <i class="fa-solid fa-circle-info"></i> Document file changes are locked. To change the attached file, delete this note and upload a fresh file.
          </p>
        </div>
      <% } %>

      <!-- Buttons -->
      <div class="btn-group" style="margin-top: 20px;">
        <button type="submit" class="btn btn-submit btn-lg">
          <i class="fa-solid fa-check"></i> Save Changes
        </button>
        <a href="/notes" class="btn btn-secondary btn-lg">
          Cancel
        </a>
      </div>

    </div>
  </form>

  <div style="text-align: center; margin-bottom: 40px;">
    <a href="/notes" class="back-dashboard">
      <i class="fa-solid fa-arrow-left"></i> Back to Notes Hub
    </a>
  </div>

</div>

<%- include("../partials/footer") %>

