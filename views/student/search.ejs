<%- include("../partials/header") %>

<div class="dashboard">
  <div class="page-header-banner">
    <h2><i class="fa-solid fa-magnifying-glass"></i> Search Results</h2>
    <p class="muted-text">Showing search results for: <strong class="text-cyan">"<%= query %>"</strong></p>
  </div>

  <div style="text-align: right; margin-bottom: 25px;">
    <a href="/notes" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Notes Hub</a>
  </div>

  <!-- Re-search bar Card -->
  <div class="card" style="margin-bottom: 30px;">
    <form action="/search" method="GET" class="search-form-row">
      <div class="input-icon-wrapper" style="flex-grow: 1;">
        <i class="fa-solid fa-magnifying-glass input-icon"></i>
        <input type="text" name="query" class="input input-with-icon" placeholder="Search by title, subject, or keyword..." value="<%= query %>" required />
      </div>
      <button type="submit" class="btn btn-submit">
        <i class="fa-solid fa-search"></i> Search
      </button>
    </form>
  </div>

  <% if (notes.length === 0) { %>
    <div class="card empty-state" style="padding: 60px 20px; text-align: center;">
      <i class="fa-solid fa-magnifying-glass-minus" style="font-size: 3rem; color: var(--accent-rose); margin-bottom: 15px;"></i>
      <h3>No Notes Found</h3>
      <p class="muted-text" style="margin-bottom: 25px;">We couldn't find any student notes matching "<%= query %>". Try searching for a subject name like "Artificial Intelligence" or "Data Structures".</p>
    </div>
  <% } else { %>
    <!-- Notes Grid -->
    <div class="notes-cards-grid">
      <% notes.forEach(note => { %>
        <div class="card note-card">
          <div>
            <!-- Subject Tag -->
            <span class="badge badge-purple" style="margin-bottom: 12px;">
              <i class="fa-solid fa-book-bookmark"></i> <%= note.subject %>
            </span>

            <!-- Note Title -->
            <h3 class="note-card-title">
              <%= note.title %>
            </h3>

            <!-- Description Truncated -->
            <p class="note-card-desc">
              <%= note.description || 'No description provided.' %>
            </p>
          </div>

          <!-- Attachment & Footer Actions -->
          <div class="note-card-footer">
            <% if (note.fileUrl) { %>
              <div class="note-attachment-row">
                <i class="fa-solid fa-paperclip text-cyan"></i>
                <a href="/notes/download/<%= note._id %>" target="_blank" class="attachment-link" download>
                  <%= note.fileName || 'Attachment PDF' %>
                </a>
              </div>
            <% } %>

            <div class="note-actions-row">
              <a href="/notes/view/<%= note._id %>" class="btn btn-secondary btn-sm" style="width: 100%;">
                <i class="fa-solid fa-eye"></i> View Note
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>

