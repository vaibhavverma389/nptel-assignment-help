<%- include("../partials/header") %>

<div class="dashboard">
  <h2 class="page-title">🔍 Search Results</h2>
  <p class="muted-text" style="text-align: center; margin-bottom: 25px;">Search query: <strong>"<%= query %>"</strong></p>

  <div style="text-align: right; margin-bottom: 25px;">
    <a href="/notes" class="btn btn-secondary">Back to Notes Hub</a>
  </div>

  <% if (notes.length === 0) { %>
    <div class="card" style="text-align: center; padding: 50px 20px;">
      <p class="warning-text" style="font-size: 1.2rem; margin-bottom: 20px; color: red;">⚠ No notes found matching "<%= query %>".</p>
      <form action="/search" method="GET" class="form-row" style="max-width: 500px; margin: 0 auto 20px;">
        <input type="text" name="query" class="input" placeholder="Try search by title or subject..." value="<%= query %>" required />
        <button type="submit" class="btn btn-submit">Search Again</button>
      </form>
    </div>
  <% } else { %>
    <!-- Re-search bar -->
    <div class="card" style="margin-bottom: 25px;">
      <form action="/search" method="GET" class="form-row" style="margin-bottom: 0;">
        <input type="text" name="query" class="input" placeholder="Search by title, subject..." value="<%= query %>" required />
        <button type="submit" class="btn btn-submit">Search</button>
      </form>
    </div>

    <!-- Notes Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <% notes.forEach(note => { %>
        <div class="card" style="margin-bottom: 0; display: flex; flex-direction: column; justify-content: space-between; min-height: 220px; position: relative; padding: 25px;">
          <div>
            <!-- Subject Tag -->
            <span class="countdown-text" style="background: rgba(0, 113, 189, 0.15); color: var(--text-secondary); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.5px; font-size: 0.75rem; border-radius: 4px; padding: 3px 8px;">
              <%= note.subject %>
            </span>

            <!-- Note Title -->
            <h3 style="margin-top: 10px; margin-bottom: 8px; font-size: 1.35rem; color: #fff; word-break: break-word;">
              <%= note.title %>
            </h3>

            <!-- Description Truncated -->
            <p class="muted-text" style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 15px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis;">
              <%= note.description || 'No description provided.' %>
            </p>
          </div>

          <!-- Attachment & Footer Actions -->
          <div style="border-top: 1px solid var(--border-light); padding-top: 15px; margin-top: 15px;">
            <% if (note.fileUrl) { %>
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 15px;">
                <span style="font-size: 1.1rem;">📎</span>
                <a href="<%= note.fileUrl %>" target="_blank" class="muted-text" style="font-size: 0.85rem; color: var(--primary-light); text-decoration: underline; word-break: break-all;" download>
                  <%= note.fileName || 'Download Attachment' %>
                </a>
              </div>
            <% } %>

            <div style="display: flex; justify-content: space-between; align-items: center;">
              <!-- View / Details Link -->
              <a href="/notes/view/<%= note._id %>" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.85rem;">
                View
              </a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include("../partials/footer") %>
