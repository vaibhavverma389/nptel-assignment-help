<%- include("../partials/header") %>

<h2 class="page-title">Submit MCQ Answers</h2>

<!-- ================= FILTER FORM (GET) ================= -->
<form method="get" action="/submit-bulk" class="form-row">

  <!-- Subject -->
  <select class="input" name="course" onchange="this.form.submit()" required>
    <option value="">Select Subject</option>
    <% subjects.forEach(s => { %>
      <option value="<%= s.name %>" <%= selectedCourse === s.name ? "selected" : "" %>>
        <%= s.name %>
      </option>
    <% }) %>
  </select>

  <!-- Week (MANUAL 1–12, NO AUTO) -->
  <select class="input" name="week" onchange="this.form.submit()" required>
    <% for (let i = 1; i <= 12; i++) { %>
      <option value="<%= i %>" <%= selectedWeek == i ? "selected" : "" %>>
        Week <%= i %>
      </option>
    <% } %>
  </select>

</form>

<!-- ================= SUBMIT FORM (POST) ================= -->
<form method="post" action="/submit-bulk" class="card">

  <!-- hidden fields -->
  <input type="hidden" name="course" value="<%= selectedCourse %>">
  <input type="hidden" name="week" value="<%= selectedWeek %>">

  <hr />

  <div id="questions-container"></div>

  <div class="btn-group">
    <button type="button" class="btn btn-add" onclick="addNewQuestion()">➕ Add Question</button>
    <button type="button" class="btn btn-remove" onclick="removeQuestion()">➖ Remove Last</button>

    <button type="submit" class="btn btn-submit">
      <%= existingAnswers.length ? "Update Answers" : "Submit All" %>
    </button>
  </div>

</form>

<a href="/dashboard" class="back-dashboard">← Back to Dashboard</a>

<script>
  let questionCount = 0;
  const existingAnswers = <%- JSON.stringify(existingAnswers || []) %>;

  function renderQuestion(questionNo, selectedOption = "") {
    questionCount = questionNo;

    const div = document.createElement("div");
    div.className = "question-row";

    div.innerHTML = `
      <span class="q-label">Question No:- ${questionNo}</span>

      <input type="hidden" name="questions[]" value="${questionNo}" />

      <select name="options[]" class="select" required>
        <option value="">Select Option</option>
        <option value="A" ${selectedOption === "A" ? "selected" : ""}>A</option>
        <option value="B" ${selectedOption === "B" ? "selected" : ""}>B</option>
        <option value="C" ${selectedOption === "C" ? "selected" : ""}>C</option>
        <option value="D" ${selectedOption === "D" ? "selected" : ""}>D</option>
        <option value="True" ${selectedOption === "True" ? "selected" : ""}>TRUE</option>
        <option value="False" ${selectedOption === "False" ? "selected" : ""}>FALSE</option>        
      </select>
    `;

    document.getElementById("questions-container").appendChild(div);
  }

  function addNewQuestion() {
    renderQuestion(questionCount + 1);
  }

  function removeQuestion() {
    const container = document.getElementById("questions-container");
    if (questionCount > 1) {
      container.removeChild(container.lastElementChild);
      questionCount--;
    }
  }

  // preload existing answers
  if (existingAnswers.length > 0) {
    existingAnswers.forEach(ans => {
      renderQuestion(ans.question, ans.option);
    });
  } else {
    renderQuestion(1);
  }
</script>

<%- include("../partials/footer") %>
