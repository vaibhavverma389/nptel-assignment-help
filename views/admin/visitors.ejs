<%- include("../partials/header") %>

<div class="card">

<h2 style="margin-bottom:10px;">Visitor Logs</h2>

<!-- SEARCH -->
<input 
  type="text"
  id="searchInput"
  placeholder="Search by Email or IP..."
  style="margin-bottom:15px;padding:8px;width:100%;max-width:350px;"
>

<div class="table-wrapper">

<table class="answers-table" id="logsTable">

<thead>
<tr>
<th>Email</th>
<th>IP</th>
<th>Path</th>
<th>Response</th>
<th>Time</th>
</tr>
</thead>

<tbody>

<% if (!logs || logs.length === 0) { %>

<tr>
<td colspan="5" style="text-align:center;">
No visitor logs found
</td>
</tr>

<% } else { %>

<% logs.forEach(v => { %>

<tr>

<!-- Email -->
<td>
<%= v.email || "Guest" %>
</td>

<!-- IP COPY -->
<td 
class="copy-ip"
title="Click to copy IP"
data-ip="<%= v.ip %>"
style="cursor:pointer;color:#007bff;"
>
<%= v.ip %>
</td>

<!-- Path -->
<td title="<%= v.path %>">
<%= v.path && v.path.length > 30
? v.path.slice(0,30) + "..."
: v.path %>
</td>

<!-- Response -->
<td>
<%= v.responseTime ? v.responseTime + " ms" : "0 ms" %>
</td>

<!-- Time -->
<td>
<%= v.visitedAt
? new Date(v.visitedAt).toLocaleString("en-IN",{timeZone:"Asia/Kolkata"})
: "" %>
</td>

</tr>

<% }) %>

<% } %>

</tbody>

</table>

</div>

</div>

<script>

/* ================= SEARCH ================= */

const searchInput = document.getElementById("searchInput");

searchInput.addEventListener("keyup", function () {

const filter = this.value.toLowerCase();

const rows = document.querySelectorAll("#logsTable tbody tr");

rows.forEach(row => {

const email = row.cells[0].textContent.toLowerCase();
const ip = row.cells[1].textContent.toLowerCase();

if (email.includes(filter) || ip.includes(filter)) {
row.style.display = "";
} else {
row.style.display = "none";
}

});

});

/* ================= COPY IP ================= */

document.querySelectorAll(".copy-ip").forEach(el => {

el.addEventListener("click", () => {

const ip = el.getAttribute("data-ip");

navigator.clipboard.writeText(ip);

el.innerText = "Copied!";

setTimeout(() => {
el.innerText = ip;
},1500);

});

});

</script>

<%- include("../partials/footer") %>