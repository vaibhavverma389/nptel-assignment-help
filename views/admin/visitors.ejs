<%- include("../partials/header") %>

<div class="card">
  <h2 style="margin-bottom:10px;">Visitor Logs</h2>

  <div class="table-wrapper">
    <table class="answers-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>IP</th>
          <th>Path</th>
          <th>Device</th>
          <th>Location</th>
          <th>Time</th>
        </tr>
      </thead>

      <tbody>
        <% logs.forEach(v => { %>
          <tr>
            <!-- Email -->
            <td>
              <%= v.email ? v.email : "Guest" %>
            </td>

            <!-- IP -->
            <td>
              <%= v.ip %>
            </td>

            <!-- Path -->
            <td title="<%= v.path %>">
              <%= v.path && v.path.length > 40
                ? v.path.substring(0, 40) + "..."
                : v.path %>
            </td>

            <!-- Device -->
            <td>
              <%= v.device?.browser || "Unknown" %> /
              <%= v.device?.os || "Unknown" %>
              (<%= v.device?.device || "desktop" %>)
            </td>

            <!-- Location -->
            <td>
              <%= v.location?.city || "Unknown" %>,
              <%= v.location?.country || "Unknown" %>
            </td>

            <!-- Time -->
            <td>
              <%= v.visitedAt
                ? new Date(v.visitedAt).toLocaleString("en-IN", {
                    timeZone: "Asia/Kolkata"
                  })
                : "" %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/footer") %>
