<%- include("../partials/header") %>

<div class="dashboard">
  <%- include("../partials/adminNav", { activeTab: 'visitors' }) %>


  <h2 style="margin-bottom:10px;">Visitor Logs</h2>

  <!-- SEARCH -->
  <input 
    type="text"
    id="searchInput"
    placeholder="Search by Email or IP..."
    style="margin-bottom:15px;padding:8px;width:100%;max-width:350px;"
  >

  <div class="table-wrapper">

    <table class="answers-table" id="logsTable">

      <thead>
        <tr>
          <th>Email</th>
          <th>IP</th>
          <th>Action</th>
          <th>Path</th>
          <th>Response</th>
          <th>Time</th>
        </tr>
      </thead>

      <tbody>

        <% if (!logs || logs.length === 0) { %>

          <tr id="noDataRow">
            <td colspan="6" style="text-align:center;">
              No visitor logs found
            </td>
          </tr>

        <% } else { %>

          <% logs.forEach(v => { %>

            <tr>

              <!-- Email -->
              <td class="email-cell">
                <strong style="color: #fff;"><%= v.email || "Guest" %></strong>
                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px;">
                  <%= v.browser || 'Browser' %> <%= v.browserVersion || '' %> on <%= v.os || 'OS' %>
                </div>
              </td>

              <!-- IP -->
              <td>
                <span class="copy-ip" title="Click to copy IP" data-ip="<%= v.ip %>" style="cursor:pointer;color:#007bff;font-weight:600;"><%= v.ip %></span>
                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 4px; line-height: 1.4;">
                  <%= (v.city || v.region) ? (v.city || v.region) + ', ' + (v.country || '') : (v.country || 'Local/Unknown') %> 
                  <br>
                  <span style="opacity: 0.8;"><%= v.isp || 'Local Network' %></span>
                </div>
              </td>

              <!-- Action -->
              <td>
                <% 
                  let badgeColor = "rgba(255,255,255,0.1)";
                  let textColor = "#fff";
                  const event = v.eventType || "visit";
                  if (event === "login" || event === "register") {
                    badgeColor = "rgba(0, 200, 83, 0.15)";
                    textColor = "#00e676";
                  } else if (event === "logout") {
                    badgeColor = "rgba(255, 23, 68, 0.15)";
                    textColor = "#ff1744";
                  } else if (event.startsWith("note-")) {
                    badgeColor = "rgba(238, 186, 27, 0.15)";
                    textColor = "#EEBA1B";
                  } else if (event.endsWith("-submit")) {
                    badgeColor = "rgba(0, 113, 189, 0.15)";
                    textColor = "#0071BD";
                  }
                %>
                <span style="background: <%= badgeColor %>; color: <%= textColor %>; padding: 3px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                  <%= event.replace(/-/g, " ") %>
                </span>

                <!-- System & Network Info -->
                <% if (v.screenWidth || v.connectionType || v.cpuCores) { %>
                  <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 6px; line-height: 1.4;">
                    <% if (v.screenWidth && v.screenHeight) { %>
                      <%= v.screenWidth %>x<%= v.screenHeight %>
                    <% } %>
                    <% if (v.connectionType) { %>
                      <%= v.connectionType.toUpperCase() %>
                    <% } %>
                    <% if (v.cpuCores || v.deviceMemory) { %>
                      <br><%= v.cpuCores ? v.cpuCores + ' CPU' : '' %> <%= v.deviceMemory ? '| ' + v.deviceMemory + 'GB RAM' : '' %>
                    <% } %>
                  </div>
                <% } %>
              </td>

              <!-- Path -->
              <td title="<%= v.path %>">
                <%= v.path && v.path.length > 30
                  ? v.path.slice(0,30) + "..."
                  : v.path %>
              </td>

              <!-- Response -->
              <td>
                <%= v.responseTime ? v.responseTime + " ms" : "0 ms" %>
              </td>

              <!-- Time -->
              <td>
                <%= v.visitedAt
                  ? new Date(v.visitedAt).toLocaleString("en-IN",{timeZone:"Asia/Kolkata"})
                  : "" %>
              </td>

            </tr>

          <% }) %>

        <% } %>

      </tbody>

    </table>

  </div>

</div>

<script>

/* ================= SEARCH (DEBOUNCED) ================= */

const searchInput = document.getElementById("searchInput");
let timeout;

searchInput.addEventListener("keyup", function () {

  clearTimeout(timeout);

  timeout = setTimeout(() => {

    const filter = this.value.toLowerCase();
    const rows = document.querySelectorAll("#logsTable tbody tr");

    let visibleCount = 0;

    rows.forEach(row => {

      if (row.cells.length < 2) return; // skip "no data" row

      const emailCell = row.cells[0];
      const ipCell = row.cells[1];

      const email = emailCell.textContent.toLowerCase();
      const ip = ipCell.textContent.toLowerCase();

      // Reset highlight
      emailCell.innerHTML = emailCell.textContent;
      ipCell.innerHTML = ipCell.textContent;

      if (email.includes(filter) || ip.includes(filter)) {

        row.style.display = "";
        visibleCount++;

        // Highlight match
        if (filter) {
          emailCell.innerHTML = emailCell.textContent.replace(
            new RegExp(filter, "gi"),
            match => `<mark>${match}</mark>`
          );

          ipCell.innerHTML = ipCell.textContent.replace(
            new RegExp(filter, "gi"),
            match => `<mark>${match}</mark>`
          );
        }

      } else {
        row.style.display = "none";
      }

    });

  }, 300);

});


/* ================= COPY IP ================= */

document.querySelectorAll(".copy-ip").forEach(el => {

  el.addEventListener("click", async () => {

    const ip = el.getAttribute("data-ip");

    try {
      await navigator.clipboard.writeText(ip);

      const original = ip;

      el.innerText = "Copied ✔";
      el.style.color = "green";

      setTimeout(() => {
        el.innerText = original;
        el.style.color = "#007bff";
      }, 1500);

    } catch (err) {
      alert("Copy failed ❌");
    }

  });

});

</script>

</div>

<%- include("../partials/footer") %>