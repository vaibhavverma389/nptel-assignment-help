<%- include("../partials/header") %>


<div class="card">
    <div class="table-wrapper">
        <table class="answers-table">
  <tr>
    <th>Email</th>
    <th>IP</th>
    <th>Path</th>
    <th>Device</th>
    <th>Time</th>
  </tr>

  <% logs.forEach(v => { %>
    <tr>
      <td><%= v.email || "Guest" %></td>
      <td><%= v.ip %></td>
      <td title="<%= v.path %>">
  <%= v.path.length > 60 ? v.path.substring(0, 40) + "..." : v.path %>
</td>
<td title="<%= v.userAgent %>">
  <%= v.userAgent.length > 60 ? v.userAgent.substring(12, 35) + "..." : v.userAgent %>
</td>

      <td><%= v.visitedAt.toLocaleString() %></td>
    </tr>
  <% }) %>
</table>

    </div>
</div>

 <%- include("../partials/footer") %>