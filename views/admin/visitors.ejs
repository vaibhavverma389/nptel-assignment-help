<%- include("../partials/header") %>

<div class="card">
  <h2 style="margin-bottom:10px;">Visitor Logs</h2>

  <div class="table-wrapper">
    <table class="answers-table">
      <thead>
        <tr>
          <th>Email</th>
          <th>IP</th>
          <th>Path</th>
          <th>Response</th>
          <th>Time</th>
        </tr>
      </thead>

      <tbody>
        <% logs.forEach(v => { %>
          <tr>
            <!-- Email -->
            <td>
              <%= v.email ? v.email : "Guest" %>
            </td>

            <!-- IP -->
            <td>
              <%= v.ip %>
            </td>

            <!-- Path -->
            <td title="<%= v.path %>">
              <%= v.path && v.path.length > 20
                ? v.path.substring(0, 20) + "..."
                : v.path %>
            </td>
            <!-- responce time -->
             
            <td>
              <%= v.responseTime || 0 %> 
            </td>
            <!-- Time -->
            <td>
              <%= v.visitedAt
                ? new Date(v.visitedAt).toLocaleString("en-IN", {
                    timeZone: "Asia/Kolkata"
                  })
                : "" %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include("../partials/footer") %>
