<%- include("../partials/header") %>

<div class="card" style="margin-bottom: 25px;">
  <h2>Student Activity Logs</h2>
  <p class="muted-text">Track which students uploaded or downloaded which notes & materials</p>
  
  <!-- FILTER FORM -->
  <form method="get" action="/admin/activity-logs" style="display: flex; flex-wrap: wrap; gap: 15px; margin-top: 20px; align-items: flex-end;">
    <!-- Search Email / Name -->
    <div style="flex: 1; min-width: 200px;">
      <label class="muted-text" style="font-size: 0.85rem; display: block; margin-bottom: 6px;">Search Student</label>
      <input 
        type="text" 
        name="email" 
        class="input" 
        placeholder="Name or Email..." 
        value="<%= filter.email %>" 
        style="margin: 0; width: 100%;"
      />
    </div>

    <!-- Action Type -->
    <div style="width: 150px; min-width: 120px;">
      <label class="muted-text" style="font-size: 0.85rem; display: block; margin-bottom: 6px;">Action</label>
      <select name="activityType" class="select" style="margin: 0; width: 100%;">
        <option value="">All Actions</option>
        <option value="upload" <%= filter.activityType === 'upload' ? 'selected' : '' %>>Upload</option>
        <option value="download" <%= filter.activityType === 'download' ? 'selected' : '' %>>Download</option>
      </select>
    </div>

    <!-- Subject -->
    <div style="width: 200px; min-width: 150px;">
      <label class="muted-text" style="font-size: 0.85rem; display: block; margin-bottom: 6px;">Subject</label>
      <select name="subject" class="select" style="margin: 0; width: 100%;">
        <option value="">All Subjects</option>
        <% subjects.forEach(s => { %>
          <option value="<%= s.name %>" <%= filter.subject === s.name ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
    </div>

    <!-- Buttons -->
    <div style="display: flex; gap: 10px; margin-bottom: 2px;">
      <button type="submit" class="btn btn-submit" style="padding: 10px 20px; font-size: 0.9rem;">Filter</button>
      <a href="/admin/activity-logs" class="btn btn-secondary" style="padding: 10px 20px; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; text-decoration: none;">Reset</a>
      
      <% 
        // Build export URL with current filters
        let exportUrl = "/admin/export/activity-logs?";
        let params = [];
        if (filter.email) params.push("email=" + encodeURIComponent(filter.email));
        if (filter.activityType) params.push("activityType=" + encodeURIComponent(filter.activityType));
        if (filter.subject) params.push("subject=" + encodeURIComponent(filter.subject));
        exportUrl += params.join("&");
      %>
      <a href="<%= exportUrl %>" class="btn btn-download" style="padding: 10px 20px; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; text-decoration: none;">Export Excel</a>
    </div>
  </form>
</div>

<div class="card">
  <div class="table-wrapper">
    <table class="answers-table">
      <thead>
        <tr>
          <th>Student</th>
          <th>Action</th>
          <th>Resource Type</th>
          <th>Title/Resource</th>
          <th>File Name</th>
          <th>Subject</th>
          <th>Time (IST)</th>
        </tr>
      </thead>
      <tbody>
        <% if (!logs || logs.length === 0) { %>
          <tr>
            <td colspan="7" style="text-align: center; padding: 30px;" class="muted-text">
              No activity logs found matching the filters
            </td>
          </tr>
        <% } else { %>
          <% logs.forEach(log => { %>
            <tr>
              <!-- Student Info -->
              <td>
                <strong style="color: #fff;"><%= log.userName %></strong>
                <div style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 3px;">
                  <%= log.email %>
                </div>
              </td>
              
              <!-- Action Badge -->
              <td>
                <% 
                  let badgeBg = "rgba(0, 113, 189, 0.15)";
                  let badgeColor = "#0071BD";
                  if (log.activityType === "upload") {
                    badgeBg = "rgba(0, 200, 83, 0.15)";
                    badgeColor = "#00e676";
                  } else if (log.activityType === "download") {
                    badgeBg = "rgba(238, 186, 27, 0.15)";
                    badgeColor = "#EEBA1B";
                  }
                %>
                <span style="background: <%= badgeBg %>; color: <%= badgeColor %>; padding: 4px 10px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                  <%= log.activityType %>
                </span>
              </td>
              
              <!-- Resource Type -->
              <td>
                <span style="color: var(--text-secondary); font-size: 0.9rem;">
                  <%= log.itemType === 'WeekMaterial' ? 'Study Resource' : 'Student Note' %>
                </span>
              </td>
              
              <!-- Resource Title -->
              <td>
                <span style="color: #fff; font-weight: 500;"><%= log.title %></span>
              </td>
              
              <!-- File Name -->
              <td style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= log.fileName %>">
                <span class="muted-text" style="font-size: 0.85rem;"><%= log.fileName %></span>
              </td>
              
              <!-- Subject -->
              <td>
                <span class="countdown-text" style="background: rgba(255,255,255,0.05); color: var(--accent-blue); padding: 3px 8px; border-radius: 4px; font-size: 0.8rem;">
                  <%= log.subject %>
                </span>
              </td>
              
              <!-- Timestamp -->
              <td style="font-size: 0.85rem; white-space: nowrap;">
                <%= log.timestamp ? new Date(log.timestamp).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }) : "" %>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<a href="/admin" class="back-dashboard">Back to Dashboard</a>

<%- include("../partials/footer") %>
