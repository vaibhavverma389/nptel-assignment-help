<%- include("../partials/header") %>

<h2 class="page-title">Admin Dashboard</h2>

<p class="page-subtitle">
  Manage students, answers, subjects and weekly materials
</p>

<div class="dashboard-actions">

  <!-- USERS -->
  <a href="/admin/users" class="dash-card">
    <h3>Users</h3>

    <p>
      <strong>Total Users:</strong>
      <%= usersCount %>
    </p>

    <div class="card-actions">
      <span>View all students</span>
    </div>
  </a>

  <!-- EXPORT USERS -->
  <a href="/admin/export/users" class="dash-card">
    <h3>Export Users</h3>
    <p>Download students data (Excel)</p>
  </a>

  <!-- ANSWERS -->
  <a href="/admin/answers" class="dash-card">
    <h3>Answers</h3>

    <p>
      <strong>Total Answers:</strong>
      <%= answersCount %>
    </p>

    <div class="card-actions">
      <span>View submissions</span>
    </div>
  </a>

  <!-- BULK SUBMIT -->
  <a href="/submit-bulk" class="dash-card">
    <h3>Submit Answers</h3>

    <p>
      Submit / Update answers (Admin)
    </p>
  </a>
<a href="/admin/materials" class="dash-card">
  <h3>Study Material</h3>

  <p>
    Upload & manage weekly PDFs
  </p>

  <div class="card-actions">
    <span>Manage Materials</span>
  </div>
</a>
  <!-- VISITORS -->
  <!-- <a href="/admin/visitors" class="dash-card">
    <h3>👁️ Visitors</h3>

    <p>
      View IP, Email & Activity
    </p>
  </a> -->

  <!-- EXPORT VISITORS -->
  <a href="/admin/export/visitors" class="dash-card">
    <h3>Export Visitors</h3>

    <p>
      Export visitors data (Excel)
    </p>
  </a>

  <!-- CONTACT MESSAGES -->
  <a href="/admin/contact-messages" class="dash-card">
    <h3>Contact Messages</h3>

    <p>
      View all student queries
    </p>
  </a>

  <!-- LOGGED IN USERS -->
  <div class="dash-card">

    <h3>Logged-in Visitors</h3>

    <p>
      <strong><%= loggedInUsers %></strong>
    </p>

  </div>

  <!-- LIVE USERS -->
  <div class="dash-card">

    <h3>Live Users</h3>

    <p>
      <strong id="liveUsers">0</strong>
    </p>

  </div>

  <!-- ACTIVITY 24H -->
  <div class="dash-card">

    <h3>Activity (Last 24h)</h3>

    <p>
      <strong>Total Logs:</strong>
      <%= logsLast24h %>
    </p>

  </div>

  <!-- NEW USERS -->
  <div class="dash-card">

    <h3>New Users (24h)</h3>

    <p>
      <strong><%= newUsersLast24h %></strong>
    </p>

  </div>


</div>

<!-- SOCKET.IO -->

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

socket.on("liveUsers", function(count){

  document.getElementById("liveUsers").innerText = count;

});

</script>

<%- include("../partials/footer") %>