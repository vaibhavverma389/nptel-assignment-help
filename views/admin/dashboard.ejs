<%- include("../partials/header") %>

<div class="dashboard">

  <div class="page-header-banner">
    <h2><i class="fa-solid fa-user-shield"></i> Admin Control Panel</h2>
    <p class="muted-text">Manage users, approve student note submissions, upload official study materials, and monitor real-time activity.</p>
  </div>

  <!-- Admin Sub Navigation Tabs -->
  <div class="admin-nav-tabs">
    <a href="/admin" class="admin-nav-link active"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
    <a href="/admin/users" class="admin-nav-link"><i class="fa-solid fa-users"></i> Users (<%= usersCount %>)</a>
    <a href="/admin/notes" class="admin-nav-link"><i class="fa-solid fa-book"></i> Student Notes</a>
    <a href="/admin/materials" class="admin-nav-link"><i class="fa-solid fa-folder-open"></i> Materials</a>
    <a href="/admin/answers" class="admin-nav-link"><i class="fa-solid fa-list-check"></i> Answers (<%= answersCount %>)</a>
    <a href="/admin/activity-logs" class="admin-nav-link"><i class="fa-solid fa-clock-rotate-left"></i> Activity Logs</a>
    <a href="/admin/contact-messages" class="admin-nav-link"><i class="fa-solid fa-envelope"></i> Messages</a>
  </div>

  <!-- Live Stats Row -->
  <div class="stats-row" style="margin-bottom: 30px;">

    <div class="stat-box highlight-cyan">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-signal"></i>
      </div>
      <div>
        <label>Active Live Users</label>
        <p><span id="liveUsers">0</span></p>
      </div>
    </div>

    <div class="stat-box highlight-week">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-users"></i>
      </div>
      <div>
        <label>Total Registered Users</label>
        <p><%= usersCount %></p>
      </div>
    </div>

    <div class="stat-box highlight-gold">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-list-check"></i>
      </div>
      <div>
        <label>Total Answers</label>
        <p><%= answersCount %></p>
      </div>
    </div>

    <div class="stat-box highlight-streak">
      <div class="stat-icon-wrap">
        <i class="fa-solid fa-bolt"></i>
      </div>
      <div>
        <label>24h Activity Logs</label>
        <p><%= logsLast24h %></p>
      </div>
    </div>

  </div>

  <!-- Dashboard Action Cards Grid -->
  <div class="dashboard-actions">

    <!-- STUDENT NOTES -->
    <a href="/admin/notes" class="dash-card">
      <div class="dash-card-icon"><i class="fa-solid fa-book-open"></i></div>
      <h3>Student Notes Approval</h3>
      <p>Review, approve, reject, or delete student-submitted notes.</p>
      <div class="card-actions">Manage Notes <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- STUDY MATERIALS -->
    <a href="/admin/materials" class="dash-card">
      <div class="dash-card-icon study-icon"><i class="fa-solid fa-file-pdf"></i></div>
      <h3>Official Study Materials</h3>
      <p>Upload and manage weekly PDFs and assignment resources.</p>
      <div class="card-actions">Manage Materials <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- USERS -->
    <a href="/admin/users" class="dash-card">
      <div class="dash-card-icon upload-icon"><i class="fa-solid fa-users-gear"></i></div>
      <h3>User Management</h3>
      <p>View registered student profiles and platform permissions.</p>
      <div class="card-actions">View All Users <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- ANSWERS -->
    <a href="/admin/answers" class="dash-card">
      <div class="dash-card-icon fav-icon"><i class="fa-solid fa-list-check"></i></div>
      <h3>MCQ Answers Key</h3>
      <p>View, verify, or update course weekly assignment answer keys.</p>
      <div class="card-actions">View Answers <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- BULK SUBMIT -->
    <a href="/submit-bulk" class="dash-card">
      <div class="dash-card-icon"><i class="fa-solid fa-pen-to-square"></i></div>
      <h3>Bulk Submit Answers</h3>
      <p>Add or update weekly assignment answer options in bulk.</p>
      <div class="card-actions">Submit Answers <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- ACTIVITY LOGS -->
    <a href="/admin/activity-logs" class="dash-card">
      <div class="dash-card-icon study-icon"><i class="fa-solid fa-clock-rotate-left"></i></div>
      <h3>Activity & Download Logs</h3>
      <p>Track student download and upload activity in real-time.</p>
      <div class="card-actions">View Logs <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- CONTACT MESSAGES -->
    <a href="/admin/contact-messages" class="dash-card">
      <div class="dash-card-icon upload-icon"><i class="fa-solid fa-envelope-open-text"></i></div>
      <h3>Contact Messages</h3>
      <p>View student support requests and inquiry submissions.</p>
      <div class="card-actions">View Messages <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- EXPORT USERS -->
    <a href="/admin/export/users" class="dash-card">
      <div class="dash-card-icon fav-icon"><i class="fa-solid fa-file-excel"></i></div>
      <h3>Export Users Data</h3>
      <p>Download complete student registry as an Excel spreadsheet.</p>
      <div class="card-actions">Download Excel <i class="fa-solid fa-arrow-right"></i></div>
    </a>

    <!-- EXPORT VISITORS -->
    <a href="/admin/export/visitors" class="dash-card">
      <div class="dash-card-icon"><i class="fa-solid fa-file-csv"></i></div>
      <h3>Export Visitors Data</h3>
      <p>Download visitor analytics and IP traffic logs (Excel).</p>
      <div class="card-actions">Export Analytics <i class="fa-solid fa-arrow-right"></i></div>
    </a>

  </div>

</div>

<!-- SOCKET.IO LIVE COUNTER -->
<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  socket.on("liveUsers", function(count){
    const el = document.getElementById("liveUsers");
    if (el) el.innerText = count;
  });
</script>

<%- include("../partials/footer") %>