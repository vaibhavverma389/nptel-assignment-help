<%- include("../partials/header") %>

<div class="dashboard">
  <%- include("../partials/adminNav", { activeTab: 'subjects' }) %>
  <h2 class="page-title">Manage Subjects</h2>


  <div class="card centered-card" style="text-align: left;">
    <form method="post" action="/admin/subjects" class="form-row">
      <input class="input" name="name" placeholder="Enter subject name (e.g. MIS)" required />
      <button class="btn btn-submit">Add Subject</button>
    </form>
  </div>

  <div class="card">
    <h3>All Subjects</h3>

    <% if (subjects.length===0) { %>
      <p class="muted-text">No subjects added yet.</p>
      <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 15px;">
          <% subjects.forEach(s=> { %>
            <div class="question-row"
              style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 10px; flex-direction: column; gap: 10px; align-items: stretch;">
              
              <!-- View Mode -->
              <div id="view-<%= s._id %>" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                <strong style="color: var(--accent-blue);">
                  <%= s.name %>
                </strong>

                <div style="display: flex; gap: 10px; align-items: center; margin: 0;">
                  <button type="button" class="btn btn-secondary" onclick="toggleEdit('<%= s._id %>')" style="padding: 8px 15px; font-size: 13px; margin: 0;">Rename</button>
                  <form method="post" action="/admin/subjects/delete/<%= s._id %>" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this subject?');">
                    <button class="btn btn-remove" style="padding: 8px 15px; font-size: 13px; margin: 0;">Delete</button>
                  </form>
                </div>
              </div>

              <!-- Edit Mode Form -->
              <form id="edit-<%= s._id %>" method="post" action="/admin/subjects/edit/<%= s._id %>" style="display: none; width: 100%; gap: 10px; margin: 0; align-items: center;">
                <input class="input" name="name" value="<%= s.name %>" required style="flex-grow: 1; margin: 0; padding: 8px;" />
                <button class="btn btn-submit" style="padding: 8px 15px; font-size: 13px; margin: 0; white-space: nowrap;">Save</button>
                <button type="button" class="btn btn-secondary" onclick="toggleEdit('<%= s._id %>')" style="padding: 8px 15px; font-size: 13px; margin: 0; white-space: nowrap;">Cancel</button>
              </form>

            </div>
            <% }) %>
        </div>
        <% } %>
  </div>

  <a href="/admin" class="back-dashboard">Back to Dashboard</a>

  <script>
    function toggleEdit(id) {
      const viewDiv = document.getElementById('view-' + id);
      const editForm = document.getElementById('edit-' + id);
      if (viewDiv.style.display === 'none') {
        viewDiv.style.display = 'flex';
        editForm.style.display = 'none';
      } else {
        viewDiv.style.display = 'none';
        editForm.style.display = 'flex';
      }
    }
  </div>

  <%- include("../partials/footer") %>