<%- include("../partials/header") %>

<div class="dashboard">

  <div class="page-header-banner">
    <h2><i class="fa-solid fa-book"></i> Manage Student Notes Submissions</h2>
    <p class="muted-text">Review, approve, reject, and manage student-uploaded lecture notes.</p>
  </div>

  <!-- Admin Sub Navigation Tabs -->
  <%- include("../partials/adminNav", { activeTab: 'notes' }) %>


  <!-- Statistics Row -->
  <div class="stats-row" style="margin-bottom: 25px;">
    <div class="stat-box highlight-cyan">
      <div class="stat-icon-wrap"><i class="fa-solid fa-layer-group"></i></div>
      <div>
        <label>Total Uploaded</label>
        <p><%= stats.total %></p>
      </div>
    </div>
    <div class="stat-box highlight-gold">
      <div class="stat-icon-wrap"><i class="fa-solid fa-clock"></i></div>
      <div>
        <label>Pending Approval</label>
        <p><%= stats.pending %></p>
      </div>
    </div>
    <div class="stat-box highlight-week">
      <div class="stat-icon-wrap"><i class="fa-solid fa-circle-check"></i></div>
      <div>
        <label>Approved</label>
        <p><%= stats.approved %></p>
      </div>
    </div>
    <div class="stat-box highlight-streak" style="border-left: 3px solid var(--accent-rose);">
      <div class="stat-icon-wrap"><i class="fa-solid fa-circle-xmark"></i></div>
      <div>
        <label>Rejected</label>
        <p><%= stats.rejected %></p>
      </div>
    </div>
  </div>

  <!-- Filters Card -->
  <div class="card" style="margin-bottom: 25px; padding: 20px;">
    <form method="get" action="/admin/notes" class="form-row" style="margin-bottom: 0; align-items: flex-end;">
      <div class="form-group" style="flex: 1; min-width: 200px;">
        <label class="form-label"><i class="fa-solid fa-filter"></i> Filter by Status</label>
        <select name="status" class="select" onchange="this.form.submit()">
          <option value="" <%= selectedStatus === "" ? "selected" : "" %>>All Statuses</option>
          <option value="pending" <%= selectedStatus === "pending" ? "selected" : "" %>>Pending Approval</option>
          <option value="approved" <%= selectedStatus === "approved" ? "selected" : "" %>>Approved</option>
          <option value="rejected" <%= selectedStatus === "rejected" ? "selected" : "" %>>Rejected</option>
        </select>
      </div>
      <div class="form-group" style="flex: 1; min-width: 200px;">
        <label class="form-label"><i class="fa-solid fa-book-bookmark"></i> Filter by Subject</label>
        <select name="subject" class="select" onchange="this.form.submit()">
          <option value="" <%= selectedSubject === "" ? "selected" : "" %>>All Subjects</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s.name %>" <%= selectedSubject === s.name ? "selected" : "" %>><%= s.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <a href="/admin/notes" class="btn btn-secondary">Clear Filters</a>
      </div>
    </form>
  </div>

  <!-- Notes List Table Card -->
  <div class="card">
    <div class="card-header-flex">
      <h3><i class="fa-solid fa-list"></i> Student Note Submissions</h3>
    </div>
    
    <% if (notes.length === 0) { %>
      <div class="empty-state-small">
        <i class="fa-solid fa-folder-open muted-icon"></i>
        <p class="muted-text">No student notes found matching these filters.</p>
      </div>
    <% } else { %>
      <div class="table-wrapper">
        <table class="answers-table">
          <thead>
            <tr>
              <th style="width: 50px;">S.N.</th>
              <th style="width: 260px;">Note Details</th>
              <th>Uploaded By</th>
              <th>File Attachment</th>
              <th>Date Uploaded</th>
              <th>Status</th>
              <th style="width: 240px; text-align: center;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% let count = 1; %>
            <% notes.forEach(note => { %>
              <tr>
                <td><%= count++ %></td>
                <td>
                  <span class="badge badge-purple" style="margin-bottom: 5px;">
                    <%= note.subject %>
                  </span>
                  <strong style="display: block; color: #fff; font-size: 0.95rem; margin-bottom: 4px;"><%= note.title %></strong>
                  <span class="muted-text" style="font-size: 0.8rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    <%= note.description || 'No description provided' %>
                  </span>
                </td>
                <td>
                  <span style="display: block; color: #fff; font-weight: 600;"><%= note.user %></span>
                  <span class="muted-text" style="font-size: 0.8rem;"><%= note.email %></span>
                </td>
                <td>
                  <% if (note.fileUrl) { %>
                    <a href="/notes/download/<%= note._id %>" target="_blank" class="btn btn-download btn-sm" download>
                      <i class="fa-solid fa-paperclip"></i> <%= note.fileName || 'Attachment' %>
                    </a>
                  <% } else { %>
                    <span class="muted-text" style="font-size: 0.85rem; font-style: italic;">No attachment</span>
                  <% } %>
                </td>
                <td style="font-size: 0.85rem; color: var(--text-secondary);">
                  <%= new Date(note.createdAt).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }) %>
                </td>
                <td>
                  <% if (note.status === 'pending') { %>
                    <span class="badge badge-warning">
                      <i class="fa-solid fa-clock"></i> Pending
                    </span>
                  <% } else if (note.status === 'rejected') { %>
                    <span class="badge badge-danger">
                      <i class="fa-solid fa-circle-xmark"></i> Rejected
                    </span>
                  <% } else { %>
                    <span class="badge badge-success">
                      <i class="fa-solid fa-circle-check"></i> Approved
                    </span>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 6px; justify-content: center; align-items: center;">
                    <% if (note.status !== 'approved') { %>
                      <form method="post" action="/admin/notes/approve/<%= note._id %>" style="margin: 0;">
                        <button type="submit" class="btn btn-submit btn-sm" title="Approve Note"><i class="fa-solid fa-check"></i> Approve</button>
                      </form>
                    <% } %>
                    <% if (note.status !== 'rejected') { %>
                      <form method="post" action="/admin/notes/reject/<%= note._id %>" style="margin: 0;">
                        <button type="submit" class="btn btn-secondary btn-sm" style="border-color: rgba(244, 63, 94, 0.4); color: var(--accent-rose);" title="Reject Note"><i class="fa-solid fa-xmark"></i> Reject</button>
                      </form>
                    <% } %>
                    <form method="post" action="/admin/notes/delete/<%= note._id %>" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this note permanently?');">
                      <button type="submit" class="btn btn-remove btn-sm" title="Delete Note"><i class="fa-solid fa-trash"></i></button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div style="text-align: center; margin-top: 25px; margin-bottom: 40px;">
    <a href="/admin" class="back-dashboard"><i class="fa-solid fa-arrow-left"></i> Back to Admin Dashboard</a>
  </div>

</div>

<%- include("../partials/footer") %>

