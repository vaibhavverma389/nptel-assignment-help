<%- include("../partials/header") %>

<div class="dashboard">
  <%- include("../partials/adminNav", { activeTab: 'materials' }) %>


  <!-- ================= UPLOAD FORM ================= -->
  <div class="card">
    <h2> Upload Study Material / Assignment</h2>

    <form action="/admin/materials" method="post" enctype="multipart/form-data" class="form-upload">

      <!-- TYPE -->
      <div class="form-group">
        <label>Select Type *</label>
        <select name="type" id="typeSelect" class="input" required onchange="toggleWeekInput()">
          <option value="material"> Study Material</option>
          <option value="assignment">Assignment PDF</option>
        </select>
      </div>

      <!-- SUBJECT -->
      <div class="form-group">
        <label>Select Subject *</label>
        <select name="subject" class="input" required>
          <% subjects.forEach(s => { %>
            <option value="<%= s.name %>"><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- WEEK -->
      <div class="form-group" id="weekGroup" style="display: none;">
        <label>Week *</label>
        <input 
          type="number" 
          name="week" 
          id="weekInput"
          placeholder="Enter Week (1-12)" 
          min="1" 
          max="12"
          class="input"
        >
      </div>

      <!-- FILE -->
      <div class="form-group">
        <label>Upload PDF *</label>
        <input 
          type="file" 
          name="pdf" 
          accept="application/pdf" 
          required 
          class="input"
        >
        <small class="help-text">Max file size: 50MB</small>
      </div>

      <button type="submit" class="btn btn-primary">
        Upload Material
      </button>

    </form>
  </div>


<div class="card">
  <h3>Uploaded Materials (<%= materials.length %>)</h3>

  <% if(materials.length === 0) { %>
    <p class="muted-text">No materials uploaded yet</p>

  <% } else { %>

    <div class="table-wrapper">
      <table class="answers-table">

        <thead>
          <tr>
            <th>#</th>
            <th>Subject</th>
            <th>Week</th>
            <th>Type</th>
            <th>Time</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% materials.forEach((m, index) => { %>
            <tr>

              <td><%= index + 1 %></td>

              <td><strong><%= m.subject %></strong></td>

              <td><%= m.week ? `Week ${m.week}` : 'N/A' %></td>

              <td>
                <%= m.type === "assignment" ? " Assignment" : " Study Material" %>
              </td>

              <td>
                <%= m.createdAt.toLocaleString() %>
              </td>

              <td>
                <div class="table-actions">

                  <!-- VIEW -->
                  <% if (m.type === 'assignment') { %>
                    <a 
                      href="/pdf/assi/<%= m.week %>?subject=<%= encodeURIComponent(m.subject) %>" 
                      target="_blank"
                      class="btn btn-secondary btn-sm"
                    >
                      View
                    </a>
                  <% } else { %>
                    <a 
                      href="<%= m.fileUrl %>" 
                      target="_blank"
                      class="btn btn-secondary btn-sm"
                    >
                      View
                    </a>
                  <% } %>

                  <!-- DELETE -->
                  <form 
                    action="/admin/materials/delete/<%= m._id %>" 
                    method="post"
                    style="display:inline;" 
                    onsubmit="return confirm('Delete this material?');"
                  >
                    <button class="btn btn-danger btn-sm  btn-remove">
                      Delete
                    </button>
                  </form>

                </div>
              </td>

            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>

  <% } %>
</div>
  <!-- ================= BACK ================= -->
  <div class="card">
    <a href="/admin" class="btn btn-secondary">Back</a>
  </div>

</div>

<!-- ================= SCRIPT ================= -->
<script>
  const fileInput = document.querySelector('input[name="pdf"]');

  fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    const maxSize = 50 * 1024 * 1024;

    if (file && file.size > maxSize) {
      alert("File too large (Max 50MB)");
      this.value = "";
    }
  });

  function toggleWeekInput() {
    const typeSelect = document.getElementById("typeSelect");
    const weekGroup = document.getElementById("weekGroup");
    const weekInput = document.getElementById("weekInput");

    if (typeSelect.value === "assignment") {
      weekGroup.style.display = "block";
      weekInput.required = true;
    } else {
      weekGroup.style.display = "none";
      weekInput.required = false;
      weekInput.value = "";
    }
  }

  // Run on startup to set initial state
  document.addEventListener("DOMContentLoaded", toggleWeekInput);
</script>

<%- include("../partials/footer") %>