<%- include("../partials/header") %>

<div class="dashboard">

  <!-- ================= UPLOAD FORM ================= -->
  <div class="card">
    <h2> Upload Study Material / Assignment</h2>

    <form action="/admin/materials" method="post" enctype="multipart/form-data" class="form-upload">

      <!-- TYPE -->
      <div class="form-group">
        <label>Select Type *</label>
        <select name="type" class="input" required>
          <option value="material"> Study Material</option>
          <option value="assignment">Assignment PDF</option>
        </select>
      </div>

      <!-- SUBJECT -->
      <div class="form-group">
        <label>Select Subject *</label>
        <select name="subject" class="input" required>
          <% subjects.forEach(s => { %>
            <option value="<%= s.name %>"><%= s.name %></option>
          <% }) %>
        </select>
      </div>

      <!-- WEEK -->
      <div class="form-group">
        <label>Week *</label>
        <input 
          type="number" 
          name="week" 
          placeholder="Enter Week (1-12)" 
          min="1" 
          max="12"
          required 
          class="input"
        >
      </div>

      <!-- FILE -->
      <div class="form-group">
        <label>Upload PDF *</label>
        <input 
          type="file" 
          name="pdf" 
          accept="application/pdf" 
          required 
          class="input"
        >
        <small class="help-text">Max file size: 50MB</small>
      </div>

      <button type="submit" class="btn btn-primary">
        📤 Upload Material
      </button>

    </form>
  </div>


<div class="card">
  <h3>Uploaded Materials (<%= materials.length %>)</h3>

  <% if(materials.length === 0) { %>
    <p class="muted-text">No materials uploaded yet</p>

  <% } else { %>

    <div class="table-wrapper">
      <table class="answers-table">

        <thead>
          <tr>
            <th>#</th>
            <th>Subject</th>
            <th>Week</th>
            <th>Type</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          <% materials.forEach((m, index) => { %>
            <tr>

              <td><%= index + 1 %></td>

              <td><strong><%= m.subject %></strong></td>

              <td>Week <%= m.week %></td>

              <td>
                <%= m.type === "assignment" ? " Assignment" : " Study Material" %>
              </td>

              

              <td>
                <div class="table-actions">

                  <!-- VIEW -->
                  <a 
                    href="/pdf/<%= m.type === 'assignment' ? 'assi' : 'study' %>/<%= m.week %>?subject=<%= encodeURIComponent(m.subject) %>" 
                    target="_blank"
                    class="btn btn-secondary btn-sm"
                  >
                    View
                  </a>

                  <!-- DELETE -->
                  <form 
                    action="/admin/materials/delete/<%= m._id %>" 
                    method="post"
                    style="display:inline;"
                    onsubmit="return confirm('Delete this material?');"
                  >
                    <button class="btn btn-danger btn-sm">
                      Delete
                    </button>
                  </form>

                </div>
              </td>

            </tr>
          <% }) %>
        </tbody>

      </table>
    </div>

  <% } %>
</div>
  <!-- ================= BACK ================= -->
  <div class="card">
    <a href="/admin" class="btn btn-secondary">← Back</a>
  </div>

</div>

<!-- ================= SCRIPT ================= -->
<script>
  const fileInput = document.querySelector('input[name="pdf"]');

  fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    const maxSize = 50 * 1024 * 1024;

    if (file && file.size > maxSize) {
      alert("File too large (Max 50MB)");
      this.value = "";
    }
  });
</script>

<%- include("../partials/footer") %>