<%- include("../partials/header") %>

  <h2 class="page-title">All Users</h2>

  <div class="card">
    <div class="table-wrapper">
      <table class="answers-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Date</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u=> { %>
            <tr>
              <td>
                <%= u.name %>
              </td>
              <td>
                <%= u.email %>
              </td>
              <td>
                <%= u.role %>
              </td>
              <td>
                
                <% 
  const d = new Date(u.date);
  const formatted = d.getDate().toString().padStart(2,'0') + '/' +
                    (d.getMonth()+1).toString().padStart(2,'0') + '/' +
                    d.getFullYear();
%>
<%= formatted %>

              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <a href="/admin" class="back-dashboard">← Back to Dashboard</a>

  <%- include("../partials/footer") %>