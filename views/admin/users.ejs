<%- include("../partials/header") %>

  <h2 class="page-title">All Users</h2>

  <%
<!-- users.sort((a, b) => a.name.localeCompare(b.name)); -->
%>

<div class="card">
  <div class="table-wrapper">
    <table class="answers-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td><%= u.role %></td>
            <td>
              <%= new Date(u.date).toLocaleString() %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>


  <a href="/admin" class="back-dashboard">← Back to Dashboard</a>

  <%- include("../partials/footer") %>