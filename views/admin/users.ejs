<%- include("../partials/header") %>

<div class="dashboard">
  <%- include("../partials/adminNav", { activeTab: 'users' }) %>
  <h2 class="page-title">All Users</h2>


  <%
<!-- users.sort((a, b) => a.name.localeCompare(b.name)); -->
%>

<div class="card">
  <div class="table-wrapper">
    <table class="answers-table">
      <thead>
        <tr>
          <th>SR no.</th>
          <th>Img</th>
          <th>Name</th>
          <th>Email</th>
          <th>Role</th>
          <th>Date</th>
          <th>Last Active</th>
        </tr>
      </thead>
      <% let i=1; %>
      <tbody>
        
        <% users.forEach(u => { %>
          <tr>
            <td><%= i++ %></td>
            <td>
          <img
            src="<%= u.photo || '/images/default-avatar.png' %>"
            alt="User Photo"
            class="user-pic"
          />
        </td>

            <td><%= u.name %></td>
            <td><%= u.email %></td>
            <td><%= u.role %></td>
            <td>
              <%= new Date(u.date).toLocaleString() %>
            </td>
            <td>
  <%= u.lastActive
    ? new Date(u.lastActive).toLocaleString("en-IN", {
        timeZone: "Asia/Kolkata"
      })
    : "—" %>
</td>

          </tr>
        <% }) %>

      </tbody>
    </table>
  </div>
</div>


  <a href="/admin" class="back-dashboard">← Back to Dashboard</a>

</div>

<%- include("../partials/footer") %>