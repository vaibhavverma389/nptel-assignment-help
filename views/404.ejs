<!DOCTYPE html>
<html>
<head>

<title>404 - Page Not Found</title>

<link rel="stylesheet" href="/css/style.css">

<meta http-equiv="refresh" content="4; url=/dashboard">

</head>

<body>

<div class="container">

  <div class="bus-groups">

    <!-- Non AC Bus -->
    <a href="/join-bus-nonac" class="bus-card-link">
      <div class="card bus-card">
        <h3>🚌 Budget Bus (Non-AC)</h3>

        <p class="muted-text">
          NPTEL exam center jaane ke liye affordable bus service.
          Updates ke liye WhatsApp group join karein.
        </p>

        <div class="join-area">
          <span class="btn-join">Join Non-AC Group</span>
        </div>
      </div>
    </a>

    <!-- AC Bus -->
    <a href="/join-bus-ac" class="bus-card-link">
      <div class="card bus-card">
        <h3>❄ Premium Bus (AC)</h3>

        <p class="muted-text">
          Comfortable AC bus se exam center travel karein.
          Updates ke liye WhatsApp group join karein.
        </p>

        <div class="join-area">
          <span class="btn-join">Join AC Group</span>
        </div>
      </div>
    </a>
    

</div>

<script>

let time = 4;

const timer = setInterval(() => {
  time--;
  document.getElementById("count").innerText = time;

  if (time <= 0) {
    clearInterval(timer);
  }
}, 1000);

</script>

</body>
</html>