<!DOCTYPE html>
<html>
<head>

<title>404 - Page Not Found</title>

<link rel="stylesheet" href="/css/style.css">

<meta http-equiv="refresh" content="4; url=/dashboard">

</head>

<body>

<div class="container">

<div class="card centered-card">

<h1 style="
font-size:80px;
background: var(--gradient-primary);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
margin-bottom:10px;
">
404
</h1>

<h2>Page Not Found</h2>

<p>
The page you are looking for does not exist or has been moved.
</p>

<p id="redirect-text">
Redirecting to dashboard in <span id="count">4</span> seconds...
</p>

<div class="btn-group">

<a href="/dashboard" class="btn btn-submit">
Go to Dashboard
</a>
</a>

</div>

</div>

</div>

<script>

let time = 4;

setInterval(()=>{
time--;
document.getElementById("count").innerText = time;
},1000);

</script>

</body>
</html>