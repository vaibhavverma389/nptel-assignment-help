<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Notes Portal</title>

  <!-- Google Fonts Integration -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>


  <header class="header">
  <div class="container header-flex">

    <a href="/" style="text-decoration: none;">
      <h2> Student Notes Portal</h2>
    </a>

    <nav class="nav-links">

      <% if (user) { %>
        <a href="/dashboard">Dashboard</a>

        <% if (user.role === "admin") { %>
          <a href="/admin">Admin Panel</a>
        <% } %>

        <a href="/auth/logout">Logout</a>

      <% } else { %>
        <a href="/auth/login">Login</a>
        <a href="/auth/register">Register</a>
      <% } %>

    </nav>

  </div>

  <script src="/js/visitorData.js"></script>
</header>

<main class="container">

  <!-- Flash Messages -->
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="alert alert-success" style="background: rgba(0, 113, 189, 0.15); border: 1px solid var(--sky); padding: 12px 20px; border-radius: var(--radius-md); margin-top: 20px; margin-bottom: 20px; color: var(--ice); font-weight: 500; display: flex; align-items: center; justify-content: space-between;">
      <span><%= success %></span>
      <button onclick="this.parentElement.style.display='none'" style="background:none; border:none; color:inherit; font-size:1.2rem; cursor:pointer; padding:0 5px;">&times;</button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="alert alert-danger" style="background: rgba(217, 48, 37, 0.15); border: 1px solid var(--danger-color); padding: 12px 20px; border-radius: var(--radius-md); margin-top: 20px; margin-bottom: 20px; color: #ff8a80; font-weight: 500; display: flex; align-items: center; justify-content: space-between;">
      <span><%= error %></span>
      <button onclick="this.parentElement.style.display='none'" style="background:none; border:none; color:inherit; font-size:1.2rem; cursor:pointer; padding:0 5px;">&times;</button>
    </div>
  <% } %>
