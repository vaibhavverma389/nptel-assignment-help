<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Notes Portal</title>

  <!-- Google Fonts Integration -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <!-- Font Awesome 6 Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

  <link rel="stylesheet" href="/css/app.css" />
</head>
<body>

<header class="header">
  <div class="container header-flex">

    <a href="/" class="brand-logo">
      <div class="logo-icon-wrap">
        <i class="fa-solid fa-graduation-cap"></i>
      </div>
      <h2>Student Notes <span>Portal</span></h2>
    </a>

    <button class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Toggle navigation">
      <i class="fa-solid fa-bars"></i>
    </button>

    <nav class="nav-links" id="navLinks">
      <a href="/"><i class="fa-solid fa-house"></i> Home</a>
      <a href="/study-material"><i class="fa-solid fa-folder-open"></i> Study Material</a>
      <a href="/notes"><i class="fa-solid fa-book"></i> Notes Hub</a>

      <% if (user) { %>
        <a href="/dashboard"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
        <a href="/favorites"><i class="fa-solid fa-star"></i> Favorites</a>
        <a href="/upload" class="nav-btn-highlight"><i class="fa-solid fa-cloud-arrow-up"></i> Upload</a>

        <% if (user.role === "admin") { %>
          <a href="/admin" class="nav-admin-pill"><i class="fa-solid fa-user-shield"></i> Admin</a>
        <% } %>

        <div class="user-chip">
          <% if (user.picture) { %>
            <img src="<%= user.picture %>" class="user-pic" alt="<%= user.name %>" />
          <% } else { %>
            <div class="user-avatar-placeholder"><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></div>
          <% } %>
          <span class="user-name"><%= user.name ? user.name.split(' ')[0] : 'User' %></span>
          <a href="/auth/logout" class="logout-link" title="Logout"><i class="fa-solid fa-right-from-bracket"></i></a>
        </div>

      <% } else { %>
        <a href="/auth/login" class="nav-login-btn"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
        <a href="/auth/register" class="btn-submit btn-sm"><i class="fa-solid fa-user-plus"></i> Register</a>
      <% } %>
    </nav>

  </div>

  <script src="/js/visitorData.js"></script>
  <script>
    document.getElementById('mobileMenuBtn')?.addEventListener('click', function() {
      document.getElementById('navLinks')?.classList.toggle('active');
    });
  </script>
</header>

<main class="container">

  <!-- Flash Messages -->
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="alert alert-success">
      <div class="alert-content">
        <i class="fa-solid fa-circle-check"></i>
        <span><%= success %></span>
      </div>
      <button onclick="this.parentElement.style.display='none'" class="alert-close">&times;</button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="alert alert-danger">
      <div class="alert-content">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
      <button onclick="this.parentElement.style.display='none'" class="alert-close">&times;</button>
    </div>
  <% } %>

